---
import GlobalHeader from './GlobalHeader.astro';
import ThemeBackground from '@components/backgrounds/ThemeBackground.astro';

// Self-hosted fonts — replaces the Google Fonts <link>, which loaded after
// first paint and caused a visible font swap/reflow. Import the @font-face
// CSS as a side effect; import the primary latin woff2 as a URL so we can
// preload it (fetched before first paint → text renders in the real font
// immediately, no swap).
import '@fontsource-variable/fraunces/standard.css';  // display: opsz + wght axes
import '@fontsource-variable/ibm-plex-sans/wght.css'; // body: wght axis
import frauncesWoff2 from '@fontsource-variable/fraunces/files/fraunces-latin-standard-normal.woff2?url';
import plexWoff2 from '@fontsource-variable/ibm-plex-sans/files/ibm-plex-sans-latin-wght-normal.woff2?url';

// Non-default theme faces — @font-face declarations only (no preload). The
// browser fetches the woff2 lazily, the first time a theme that actually uses
// the family becomes active, so the default theme's first paint is unaffected.
import '@fontsource-variable/inter/wght.css';          // minimal theme
import '@fontsource-variable/newsreader/standard.css'; // broadsheet body

export interface Props {
  title?: string;
  description?: string;
  canonicalURL?: string;
  image?: string;
  robots?: string;
  themeColor?: string;
  ogType?: string;
  articlePublishedTime?: string;
  articleAuthor?: string;
  articleTags?: string[];
  showGlobalHeader?: boolean;
  themeBackground?: boolean;
}

const {
  title = 'Joel Lithgow - Creative Technologist',
  description = 'I transform complex ideas into intuitive digital experiences through design thinking and technical expertise.',
  canonicalURL = Astro.url.href,
  image = '/assets/og-image.png',
  robots = 'index, follow',
  themeColor = '#ff6b6b',
  ogType = 'website',
  articlePublishedTime,
  articleAuthor,
  articleTags,
  showGlobalHeader = true,
  themeBackground = true
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <!-- Google Tag Manager -->
  <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
  new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
  j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
  'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
  })(window,document,'script','dataLayer','GTM-K858Q6JF');</script>
  <!-- End Google Tag Manager -->
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content={description}>
  <meta name="keywords" content="creative technologist, UX designer, frontend developer, AI-augmented development, rapid prototyping">
  <meta name="author" content="Joel Lithgow">
  <meta name="theme-color" content={themeColor}>
  <meta name="robots" content={robots}>
  
  <!-- Canonical URL -->
  <link rel="canonical" href={canonicalURL}>
  
  <!-- Open Graph / Facebook -->
  <meta property="og:type" content={ogType}>
  <meta property="og:url" content={canonicalURL}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:image" content={new URL(image, Astro.url).href}>
  <meta property="og:image:alt" content={title}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:type" content="image/png">
  <meta property="og:site_name" content="Joel Lithgow">
  <meta property="og:locale" content="en_US">
  {articlePublishedTime && <meta property="article:published_time" content={articlePublishedTime}>}
  {articleAuthor && <meta property="article:author" content={articleAuthor}>}
  {articleTags && articleTags.map((tag) => <meta property="article:tag" content={tag}>)}

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:site" content="@joellithgow">
  <meta name="twitter:creator" content="@joellithgow">
  <meta name="twitter:url" content={canonicalURL}>
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={new URL(image, Astro.url).href}>
  <meta name="twitter:image:alt" content={title}>
  
  <!-- Structured Data -->
  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "Person",
    "name": "Joel Lithgow",
    "jobTitle": "Creative Technologist",
    "description": "I transform complex ideas into intuitive digital experiences through design thinking and technical expertise.",
    "url": "https://joellithgow.com",
    "sameAs": [
      "https://linkedin.com/in/joellithgow",
      "https://github.com/joellithgow"
    ]
  }
  </script>
  
  <title>{title}</title>
  
  <!-- Early theme loading to prevent flash - minimal code for performance -->
  <script is:inline>
    // Load saved theme immediately to prevent flash of wrong theme
    (function() {
      const themes = ['default', 'minimal', 'broadsheet'];
      let savedTheme = localStorage.getItem('portfolio-theme') || 'default';

      // Validate theme
      if (!themes.includes(savedTheme)) {
        savedTheme = 'default';
        localStorage.setItem('portfolio-theme', 'default');
      }

      document.documentElement.setAttribute('data-theme', savedTheme);
    })();
  </script>
  
  <!-- Fonts: Fraunces (display) + IBM Plex Sans (body), self-hosted via
       @fontsource (see frontmatter imports). Monaco (system) is the utility
       face. Preload the latin woff2s so they're ready before first paint. -->
  <link rel="preload" href={frauncesWoff2} as="font" type="font/woff2" crossorigin />
  <link rel="preload" href={plexWoff2} as="font" type="font/woff2" crossorigin />

  <!-- Favicon -->
  <link rel="icon" type="image/x-icon" href="/assets/favicon.ico">
  <link rel="apple-touch-icon" sizes="180x180" href="/assets/apple-touch-icon.png">
  <link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/assets/favicon-16x16.png">
  <link rel="manifest" href="/assets/site.webmanifest">

  <!-- RSS Feed -->
  <link rel="alternate" type="application/rss+xml" title="Joel Lithgow's Blog" href="/rss.xml" />

  <!-- Astraeus inline editor — loaded only when PUBLIC_CMS_BASE is set.
       defer, so a slow or unreachable CMS can't hold up first paint (a plain
       script in <head> blocks rendering). Not async: document.currentScript is
       still set while a deferred classic script runs, and defer keeps the order
       and waits for the DOM, which the embed's querySelectorAll needs. -->
  {import.meta.env.PUBLIC_CMS_BASE && (
    <script
      defer
      src={`${import.meta.env.PUBLIC_CMS_BASE}/editor/embed.js`}
      data-cms-base={import.meta.env.PUBLIC_CMS_BASE}
      data-cms-media-base={import.meta.env.PUBLIC_MEDIA_BASE}
      data-reload-url={import.meta.env.DEV ? `${Astro.url.origin}/__cms-reload` : undefined}
      is:inline
    />
  )}
</head>
<body class={showGlobalHeader ? 'has-global-header' : ''}>
  <!-- Google Tag Manager (noscript) -->
  <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-K858Q6JF"
  height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
  <!-- End Google Tag Manager (noscript) -->

  <!-- Site-wide animated background, swapped live per active theme -->
  {themeBackground && <ThemeBackground />}

  <!-- Skip to main content link for screen readers -->
  <a href="#main-content" class="skip-link" aria-label="Skip to main content">Skip to main content</a>

  <!-- Global header with logo/home link (hidden on landing page) -->
  {showGlobalHeader && <GlobalHeader />}

  <slot />

  <!-- Click music Easter egg: off until turned on from the home page's speaker node -->
  <script>
    import { initClickMusic } from '@features/click-music';
    initClickMusic();
  </script>
  
  <!-- Screen reader only content -->
  <div class="sr-only">
    <div>This website uses themes. Press Ctrl+T to cycle through available themes.</div>
    <div>Some elements on this page are interactive and can be dragged around.</div>
  </div>
</body>
</html>

<style>
  /* Import design system */
  @import '../../styles/tokens.css';
  @import '../../styles/themes.css';

  /* Base styles and CSS custom properties */
  :global(html) {
    font-family: system-ui, sans-serif;
    scroll-behavior: smooth;
  }

  :global(body) {
    margin: 0;
    padding: 0;
    background: var(--bg-primary);
    color: var(--text-primary);
    line-height: var(--leading-relaxed);
  }

  /* No padding needed - header appears on scroll and overlays content */

  /* Accessibility styles */
  :global(.sr-only) {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .skip-link {
    position: absolute;
    top: calc(var(--space-3xl) * -1);
    left: var(--space-xs);
    background: var(--bg-dark);
    color: var(--text-light);
    padding: var(--space-sm);
    text-decoration: none;
    z-index: 100;
    border-radius: var(--radius-sm);
  }

  .skip-link:focus {
    top: var(--space-xs);
  }

  /* Focus styles */
  :global(:focus) {
    outline: var(--border-width) solid var(--accent-primary);
    outline-offset: var(--space-xs);
  }

  /* Reduced motion support */
  @media (prefers-reduced-motion: reduce) {
    :global(*) {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
      scroll-behavior: auto !important;
    }
  }
</style>