---
/**
 * One hand-drawn shape (astraeus starlette_cms.drawing.Drawing) as inline SVG.
 * Shared by doodles and taste shapes. Strokes default to currentColor, so a
 * drawing follows the theme it sits in. The markup is src/lib/slice-html.ts
 * (drawingSvgHtml), which the live editor's draft preview draws with too.
 */
import type { Drawing } from '@lib/astraeus-types';
import { drawingSvgHtml } from '@lib/slice-html';

export interface Props {
  drawing: Drawing;
  class?: string;
  style?: string;
  /** A light graphite roughness on the edges (render only; nothing stored) */
  pencil?: boolean;
  [attr: `data-${string}`]: string | undefined;
}

const { drawing, class: className, style, pencil = false, ...rest } = Astro.props;
---

<Fragment set:html={drawingSvgHtml(drawing, { className, style, pencil, attrs: rest as Record<string, string | undefined> })} />
