---
/**
 * LinksSlice — link documents from a post's links slice. Full: the same
 * accordion as /blog/links. Compact (feed card): the first few titles.
 */
import LinksAccordion from '../LinksAccordion.astro';
import type { Link } from '@lib/slices';
import { linksSliceCompactHtml } from '@lib/slice-html';

export interface Props {
  links: Link[];
  compact?: boolean;
}

const { links, compact = false } = Astro.props;
// The compact form is src/lib/slice-html.ts, shared with the live editor's draft
// preview, so the styles are global, scoped by .slice--links.
---

{compact ? (
  <Fragment set:html={linksSliceCompactHtml(links)} />
) : (
<section class="slice slice--links">
  <LinksAccordion links={links.map((l) => ({ url: l.url, title: l.title, description: l.description ?? undefined, tags: l.tags ?? undefined }))} />
</section>
)}

<style is:global>
  @import '../../../styles/tokens.css';

  .slice--links { margin: var(--space-lg) 0; }
  .slice--links .slice-link-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: var(--space-xs); }
  .slice--links .slice-link-list a { color: var(--text-primary); }
  .slice--links .slice-link-list a:hover { color: var(--accent-primary); }
  .slice--links .slice-link-more { font-size: var(--text-xs); color: var(--text-secondary); }
</style>
