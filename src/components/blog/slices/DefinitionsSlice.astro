---
/**
 * DefinitionsSlice — dictionary entries a post picked, each linking to its
 * page under /blog/dictionary/. Compact cuts the definition short.
 */
import type { Entry } from '@lib/slices';
import { definitionsSliceCompactHtml } from '@lib/slice-html';

export interface Props {
  definitions: Entry[];
  compact?: boolean;
}

const { definitions, compact = false } = Astro.props;
// The compact form is src/lib/slice-html.ts, shared with the live editor's draft
// preview, so the styles are global, scoped by .slice--definitions.
---

{compact ? (
  <Fragment set:html={definitionsSliceCompactHtml(definitions)} />
) : (
<section class="slice slice--definitions">
  {definitions.map((d) => (
    <div class="slice-definition">
      <a href={`/blog/dictionary/${d.slug}`} class="slice-term">{d.term}</a>
      <blockquote class="slice-definition-text">{d.definition}</blockquote>
    </div>
  ))}
</section>
)}

<style is:global>
  @import '../../../styles/tokens.css';

  .slice--definitions { margin: var(--space-lg) 0; display: flex; flex-direction: column; gap: var(--space-md); }
  .slice--definitions .slice-term { font-family: var(--font-display); font-weight: var(--font-semibold); font-size: var(--text-lg); color: var(--text-primary); }
  .slice--definitions .slice-term:hover { color: var(--accent-primary); }
  .slice--definitions .slice-definition-text {
    margin: var(--space-xs) 0 0 0;
    padding-left: var(--space-md);
    border-left: 3px solid var(--accent-secondary);
    color: var(--text-secondary);
  }
</style>
