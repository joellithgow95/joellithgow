---
/**
 * TastesSlice — taste shapes a post shows (taste_picks, tastes_range). Three forms:
 * - beat: a feed beat about one item: the shape, the photo beside it if any, the note.
 * - compact: a post's feed card: a row of shapes with names.
 * - full: the post page: each shape large with its name, details and photo.
 */
import DrawingSvg from '@components/common/DrawingSvg.astro';
import { tasteAnchor, tastePhotoUrl, type TasteShape } from '@lib/tastes';
import { tasteMeta, tastesSliceHtml } from '@lib/slice-html';

export interface Props {
  tastes: TasteShape[];
  compact?: boolean;
  beat?: boolean;
}

const { tastes, compact = false, beat = false } = Astro.props;
const href = (t: TasteShape) => `/blog/tastes#${tasteAnchor(t)}`;
const photo = (t: TasteShape, w?: number) => tastePhotoUrl(t.photo, w);
const meta = tasteMeta;
// The beat and compact forms are src/lib/slice-html.ts, shared with the live
// editor's draft preview, so the styles are global, scoped by .slice--tastes.
---

{beat || compact ? (
  <Fragment set:html={tastesSliceHtml(tastes, beat)} />
) : (
  <section class="slice slice--tastes">
    <div class="tastes-full">
      {tastes.map((t) => (
        <figure class="taste-entry" id={tasteAnchor(t)}>
          <div class="taste-entry-pics">
            <span class="taste-paper taste-paper--large">{t.shape ? <DrawingSvg drawing={t.shape} pencil class="taste-svg" /> : <span class="taste-blank">{t.name}</span>}</span>
            {t.photo && <img class="taste-photo" src={photo(t)} alt={t.name} loading="lazy" />}
          </div>
          <figcaption>
            <a href={href(t)} class="taste-name taste-name--large">{t.name}</a>
            <p class="taste-meta">{meta(t)}</p>
            {t.note && <p class="taste-note">{t.note}</p>}
          </figcaption>
        </figure>
      ))}
    </div>
  </section>
)}

<style is:global>
  @import '../../../styles/tokens.css';

  .slice--tastes { margin: var(--space-lg) 0; }
  .slice--tastes .slice-count { font-size: var(--text-xs); color: var(--text-secondary); margin: var(--space-sm) 0 0 0; }

  /* The shape always sits on its own square of light paper, in any theme: its colours are its own */
  .slice--tastes .taste-paper {
    display: block;
    aspect-ratio: 1;
    background: #fbfaf7;
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: var(--radius-sm);
    color: var(--text-primary);
    padding: 8px;
    box-sizing: border-box;
  }
  .slice--tastes .taste-blank { display: flex; align-items: center; justify-content: center; height: 100%; text-align: center; font-size: var(--text-xs); color: #6b7078; }
  .slice--tastes .taste-paper .taste-svg { width: 100%; height: 100%; display: block; overflow: visible; }
  .slice--tastes .taste-photo { display: block; aspect-ratio: 1; object-fit: cover; border-radius: var(--radius-sm); }

  /* Beat */
  .slice--tastes.tastes-beat { display: flex; gap: var(--space-md); align-items: flex-start; margin: var(--space-sm) 0 0 0; }
  .slice--tastes .taste-paper--beat { width: 120px; flex: none; }
  .slice--tastes .taste-photo.taste-photo--beat { width: 120px; flex: none; }
  .slice--tastes .tastes-beat-text { min-width: 0; }
  .slice--tastes .taste-note { margin: 0 0 var(--space-xs) 0; color: var(--text-primary); font-style: italic; }
  .slice--tastes .taste-meta { margin: 0; font-size: var(--text-xs); color: var(--text-secondary); text-transform: none; }

  /* Feed card row */
  .slice--tastes .tastes-row { display: grid; grid-template-columns: repeat(auto-fill, minmax(96px, 1fr)); gap: var(--space-sm); }
  .slice--tastes .taste-tile { display: flex; flex-direction: column; gap: var(--space-xs); text-decoration: none; color: inherit; }
  .slice--tastes .taste-name { font-size: var(--text-xs); color: var(--text-secondary); line-height: 1.3; }
  .slice--tastes .taste-tile:hover .taste-name { color: var(--accent-primary); }

  /* Post page */
  .slice--tastes .tastes-full { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: var(--space-lg); }
  .slice--tastes .taste-entry { margin: 0; }
  .slice--tastes .taste-entry-pics { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-sm); }
  .slice--tastes .taste-entry-pics:has(> :only-child) { grid-template-columns: 1fr; max-width: 50%; }
  .slice--tastes .taste-photo { width: 100%; }
  .slice--tastes .taste-name--large {
    display: block; margin-top: var(--space-sm);
    font-family: var(--font-display); font-size: var(--text-lg); color: var(--text-primary);
    text-decoration: underline; text-decoration-color: var(--accent-secondary); text-underline-offset: 3px;
  }

  @media (max-width: 480px) {
    .slice--tastes .taste-paper--beat, .slice--tastes .taste-photo.taste-photo--beat { width: 96px; }
    .slice--tastes.tastes-beat { flex-wrap: wrap; }
    .slice--tastes .tastes-beat-text { flex-basis: 100%; }
  }
</style>
