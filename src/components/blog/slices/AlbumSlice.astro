---
/**
 * AlbumSlice — saved albums a post shows (album_picks). Two forms:
 * - beat: a feed beat about one album: a large cover, then artist, year and track count.
 *   The beat's title links to the album on Spotify (see the feed page).
 * - otherwise (feed card or post page): one row per album, a small cover beside its
 *   name (linked to Spotify), artist, year and track count.
 *
 * The markup is src/lib/slice-html.ts, shared with the live editor's draft preview,
 * so the styles are global, scoped by .slice--albums.
 */
import type { Album } from '@lib/slices';
import { albumSliceHtml } from '@lib/slice-html';

export interface Props {
  albums: Album[];
  beat?: boolean;
}

const { albums, beat = false } = Astro.props;
---

<Fragment set:html={albumSliceHtml(albums, beat)} />

<style is:global>
  @import '../../../styles/tokens.css';

  .slice--albums { margin: var(--space-lg) 0; }
  .slice--albums .album-cover { display: block; aspect-ratio: 1; object-fit: cover; border-radius: var(--radius-sm); }
  .slice--albums .album-meta { margin: 0; font-size: var(--text-xs); color: var(--text-secondary); }

  /* Beat */
  .slice--albums.album-beat { margin: var(--space-sm) 0 0 0; }
  .slice--albums .album-cover-link { display: block; width: min(240px, 100%); margin-bottom: var(--space-sm); }
  .slice--albums .album-cover--beat { width: 100%; }

  /* Feed card and post page */
  .slice--albums .album-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: var(--space-sm); }
  .slice--albums .album-row { display: flex; gap: var(--space-md); align-items: center; }
  .slice--albums .album-row .album-cover { width: 64px; flex: none; }
  .slice--albums .album-text { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .slice--albums .album-name {
    font-weight: var(--font-semibold); color: var(--text-primary);
    text-decoration: underline; text-decoration-color: var(--accent-secondary); text-underline-offset: 3px;
  }
  .slice--albums a.album-name:hover { color: var(--accent-primary); }
</style>
