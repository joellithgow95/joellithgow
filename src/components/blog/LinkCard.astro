---
/**
 * LinkCard - Reusable link card component for blog posts
 *
 * A consistent component for displaying curated links across the site.
 * Uses the Card primitive for base styling and design system tokens.
 *
 * Usage:
 *   <LinkCard link={linkData} variant="minimal" />
 *   <LinkCard link={linkData} variant="playful" />
 */

import Card from '@components/primitives/Card.astro';

export interface SourcePost {
  title: string;
  slug: string;
  publishDate: Date;
  author: string;
}

export interface LinkData {
  url: string;
  title: string;
  description: string;
  author?: string;
  /** Legacy: Date object. Prefer date_added (ISO string) from CMS. */
  dateAdded?: Date;
  /** ISO 8601 string from Astraeus CMS */
  date_added?: string;
  tags?: string[];
  sourcePost?: SourcePost;
}

export interface Props {
  link: LinkData;
  variant?: 'minimal' | 'playful';
  showSourceInfo?: boolean;
  class?: string;
}

const {
  link,
  variant = 'minimal',
  showSourceInfo = false,
  class: className = '',
} = Astro.props;

// Resolve display date from either date_added (ISO string) or legacy dateAdded (Date)
const displayDate = link.date_added
  ? new Date(link.date_added)
  : link.dateAdded instanceof Date
    ? link.dateAdded
    : link.dateAdded
      ? new Date(link.dateAdded as unknown as string)
      : null;

const cardClasses = [
  'link-card',
  `link-card--${variant}`,
  className,
].filter(Boolean).join(' ');
---

<Card
  variant="default"
  padding="lg"
  href={showSourceInfo ? undefined : link.url}
  class={cardClasses}
>
  <div class="link-card-content">
    {showSourceInfo && link.sourcePost && (
      <div class="link-card-header">
        <div class="source-info">
          <span class="source-label">from</span>
          <span class="source-link">{link.sourcePost.title}</span>
        </div>
      </div>
    )}

    <h3 class="link-title">
      {showSourceInfo ? (
        <a href={link.url} class="link-url" rel={link.url.startsWith('http') ? 'noopener noreferrer' : undefined} target={link.url.startsWith('http') ? '_blank' : undefined}>
          {link.title}
        </a>
      ) : (
        link.title
      )}
    </h3>

    <p class="link-description">
      {link.description}
    </p>

    {link.author && (
      <p class="link-author">
        by {link.author}
      </p>
    )}

    {link.tags && link.tags.length > 0 && (
      <div class="link-tags-wrapper">
        {link.tags.map(tag => (
          <span class="link-tag">#{tag}</span>
        ))}
      </div>
    )}
  </div>
</Card>

<style>
  @import '../../styles/tokens.css';
  @import '../../styles/themes.css';

  /* Link card content wrapper - uses flexbox for proper spacing */
  .link-card-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  /* Header with source info */
  .link-card-header {
    /* Spacing handled by parent's gap */
  }

  .source-info {
    display: flex;
    align-items: start;
    gap: var(--space-xs);
    font-size: var(--text-sm);
  }

  .source-label {
    color: var(--text-secondary);
    font-style: italic;
  }

  .source-link {
    color: var(--accent-secondary);
    text-decoration: none;
    font-weight: var(--font-bold);
    transition: all var(--duration-base) var(--ease-out);
  }

  .source-link:hover {
    color: var(--accent-primary);
  }

  /* Tags at bottom */
  .link-tags-wrapper {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-top: var(--space-xs);
  }

  .link-tag {
    display: inline-block;
    background: var(--bg-secondary);
    color: var(--text-primary);
    padding: var(--space-xs) var(--space-sm);
    font-size: var(--text-xs);
    border: var(--border-width-thin) solid var(--accent-secondary);
    border-radius: var(--radius-sm);
    font-weight: var(--font-bold);
  }

  /* Title with external link icon */
  .link-title {
    font-size: var(--text-xl);
    font-weight: var(--font-bold);
    margin: 0;
    line-height: var(--leading-tight);
    color: var(--text-primary);
    position: relative;
  }

  /* Link within title (when showSourceInfo is true) */
  .link-url {
    color: inherit;
    text-decoration: none;
    transition: color var(--duration-base) var(--ease-out);
  }

  .link-url:hover {
    color: var(--accent-primary);
  }

  .link-title::after {
    content: "↗";
    font-size: 0.7em;
    margin-left: var(--space-xs);
    opacity: 0.5;
    transition: all var(--duration-base) var(--ease-out);
  }

  :global(.link-card--minimal:hover) .link-title::after,
  :global(.link-card--playful:hover) .link-title::after {
    opacity: 1;
    transform: translate(2px, -2px);
  }

  /* Description */
  .link-description {
    color: var(--text-primary);
    line-height: var(--leading-normal);
    margin: 0;
    font-size: var(--text-sm);
  }

  /* Author */
  .link-author {
    color: var(--text-secondary);
    font-size: var(--text-xs);
    font-style: italic;
    margin: 0;
  }

  /* Minimal variant - clean and subtle with hover state */
  :global(.link-card--minimal:hover) {
    background: var(--bg-secondary);
    border-color: var(--accent-primary);
  }

  :global(.link-card--minimal:hover) .link-title {
    color: var(--accent-primary);
  }

  /* Playful variant - adds transforms and bolder styling to the Card */
  :global(.link-card--playful) {
    transform: rotate(0.5deg);
  }

  :global(.link-card--playful:nth-child(even)) {
    transform: rotate(-0.5deg);
  }

  :global(.link-card--playful:hover) {
    transform: rotate(0deg) scale(1.02);
    background: var(--bg-secondary);
    border-color: var(--accent-primary);
  }

  :global(.link-card--playful:hover) .link-title {
    color: var(--accent-primary);
  }

  .link-card--playful .link-tag {
    transform: rotate(-1deg);
    transition: all var(--duration-base) var(--ease-out);
  }

  .link-card--playful .link-tag:nth-child(even) {
    transform: rotate(1deg);
  }

  .link-card--playful .link-tag:hover {
    transform: scale(1.05);
    background: var(--accent-secondary);
    color: var(--text-light);
  }

  .link-card--playful .source-link:hover {
    transform: rotate(-1deg);
  }

  /* Responsive adjustments */
  @media (max-width: 768px) {
    .link-title {
      font-size: var(--text-lg);
    }

    /* Remove transforms on mobile for cleaner layout */
    :global(.link-card--playful),
    :global(.link-card--playful:nth-child(even)) {
      transform: rotate(0deg);
    }

    :global(.link-card--playful:hover) {
      transform: scale(1.02);
    }

    .link-card--playful .link-tag {
      transform: rotate(0deg);
    }
  }

  /* Reduced motion support */
  @media (prefers-reduced-motion: reduce) {
    :global(.link-card--playful),
    :global(.link-card--playful:nth-child(even)),
    :global(.link-card--playful:hover) {
      transition: none;
      transform: none;
    }
  }
</style>
