---
/**
 * PROTOTYPE — feed layouts for a post that is mostly a definition (a post
 * whose only slice is definition_picks). Picked by PROTOTYPE_FEED at build
 * time; not wired to any CMS field yet.
 *
 * - beat:   a tight entry, Simon Willison "beats" style. Kicker + term as the
 *           headline, the definition, Joel's note as a short comment line.
 * - entry:  no post title or tagline: the dictionary entry is the header, and
 *           Joel's note sits under it as the post.
 * - kicker: the post keeps its own title (a take, not the term) with the term
 *           as a small kicker above it, linking to the dictionary.
 */
import { marked } from 'marked';
import type { Entry } from '@lib/slices';

export interface Props {
  variant: 'beat' | 'entry' | 'kicker';
  href: string;
  date: string;
  title: string;
  description?: string;
  body: string;
  tags?: string[];
  definitions: Entry[];
}

const { variant, href, date, title, description, body, tags = [], definitions } = Astro.props;
const d = new Date(date);
const dateLabel = d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
const shortDate = d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', timeZone: 'UTC' });
const note = body ? (marked.parse(body) as string) : '';
const terms = definitions.map((x) => x.term).join(' / ');
---

{variant === 'beat' && (
  <div class="beat">
    <div class="beat-meta">
      <span class="beat-kind">Defined</span>
      <a href={href} class="beat-date">{shortDate}</a>
    </div>
    <div class="beat-main">
      {definitions.map((x) => (
        <p class="beat-line">
          <a href={`/blog/dictionary/${x.slug}`} class="beat-term">{x.term}</a>
          <span class="beat-def">{x.definition}</span>
        </p>
      ))}
      {note && <div class="beat-note" set:html={note} />}
      {tags.length > 0 && (
        <p class="beat-tags">{tags.map((t) => <a href={`/blog/tags/${t}`}>#{t}</a>)}</p>
      )}
    </div>
  </div>
)}

{variant === 'entry' && (
  <div class="entry">
    <time class="record-date">{dateLabel}</time>
    {definitions.map((x) => (
      <div class="entry-head">
        <a href={`/blog/dictionary/${x.slug}`} class="entry-term">{x.term}</a>
        <span class="entry-label">from the dictionary</span>
        <p class="entry-def">{x.definition}</p>
      </div>
    ))}
    {note && <div class="entry-note" set:html={note} />}
    <p class="entry-foot">
      <a href={href}>Permalink</a>
      {tags.map((t) => <a href={`/blog/tags/${t}`} class="entry-tag">#{t}</a>)}
    </p>
  </div>
)}

{variant === 'kicker' && (
  <div class="kick">
    <time class="record-date">{dateLabel}</time>
    <a href={`/blog/dictionary/${definitions[0]?.slug}`} class="kick-kicker">
      Definition{definitions.length > 1 ? 's' : ''}: {terms} →
    </a>
    <h2 class="kick-title"><a href={href}>{title}</a></h2>
    {description && <p class="kick-desc">{description}</p>}
    {note && <div class="kick-note" set:html={note} />}
    {definitions.map((x) => (
      <blockquote class="kick-quote">
        <p>{x.definition}</p>
        <cite>— <a href={`/blog/dictionary/${x.slug}`}>{x.term}</a>, Joel's dictionary</cite>
      </blockquote>
    ))}
    {tags.length > 0 && (
      <p class="kick-tags">{tags.map((t) => <a href={`/blog/tags/${t}`}>#{t}</a>)}</p>
    )}
  </div>
)}

<style>
  @import '../../styles/tokens.css';

  a { color: inherit; }

  /* ---- beat ---- */
  .beat {
    display: grid;
    grid-template-columns: 7rem 1fr;
    gap: var(--space-md);
    max-width: 68ch;
  }
  .beat-meta { display: flex; flex-direction: column; gap: 2px; padding-top: 3px; }
  .beat-kind {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--accent-secondary);
    font-weight: var(--font-semibold);
  }
  .beat-date { font-family: var(--font-mono); font-size: var(--text-xs); color: var(--text-secondary); text-decoration: none; }
  .beat-date:hover { color: var(--accent-primary); }
  .beat-line { margin: 0 0 var(--space-xs); font-family: var(--font-body); line-height: var(--leading-relaxed); color: var(--text-secondary); }
  .beat-term {
    font-family: var(--font-display);
    font-weight: var(--font-semibold);
    font-size: var(--text-lg);
    color: var(--text-primary);
    text-decoration: none;
    margin-right: 0.4em;
  }
  .beat-term:hover { color: var(--accent-primary); }
  .beat-def::before { content: '— '; }
  .beat-note {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--text-primary);
    margin-top: var(--space-xs);
  }
  .beat-note :global(p) { margin: 0; }
  .beat-note :global(p)::before { content: 'Joel: '; font-family: var(--font-mono); font-size: var(--text-xs); color: var(--accent-primary); }
  .beat-tags { margin: var(--space-xs) 0 0; display: flex; gap: var(--space-sm); font-family: var(--font-mono); font-size: var(--text-xs); color: var(--text-secondary); }
  .beat-tags a { text-decoration: none; }
  @media (max-width: 600px) {
    .beat { grid-template-columns: 1fr; gap: var(--space-xs); }
    .beat-meta { flex-direction: row; gap: var(--space-sm); }
  }

  /* ---- entry ---- */
  .entry { max-width: 68ch; }
  .record-date {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-secondary);
    letter-spacing: var(--tracking-wide);
    margin-bottom: var(--space-xs);
  }
  .entry-head {
    border: 1px solid var(--gradient-primary-subtle);
    border-left: 4px solid var(--accent-secondary);
    padding: var(--space-md) var(--space-lg);
    margin-bottom: var(--space-md);
  }
  .entry-term {
    font-family: var(--font-display);
    font-weight: var(--font-semibold);
    font-size: var(--heading-md);
    line-height: var(--leading-tight);
    color: var(--text-primary);
    text-decoration: none;
    margin-right: var(--space-sm);
  }
  .entry-term:hover { color: var(--accent-primary); }
  .entry-label { font-family: var(--font-mono); font-size: var(--text-xs); color: var(--text-secondary); font-style: italic; }
  .entry-def { margin: var(--space-sm) 0 0; font-family: var(--font-display); font-size: var(--text-lg); line-height: var(--leading-relaxed); color: var(--text-primary); }
  .entry-note { font-family: var(--font-body); line-height: var(--leading-relaxed); color: var(--text-secondary); }
  .entry-note :global(p) { margin: 0 0 var(--space-sm); }
  .entry-foot { display: flex; flex-wrap: wrap; gap: var(--space-sm); margin: var(--space-sm) 0 0; font-family: var(--font-mono); font-size: var(--text-xs); }
  .entry-foot a { color: var(--accent-primary); }
  .entry-foot .entry-tag { color: var(--text-secondary); text-decoration: none; }

  /* ---- kicker ---- */
  .kick { max-width: 68ch; }
  .kick-kicker {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--accent-secondary);
    font-weight: var(--font-semibold);
    text-decoration: none;
    margin-bottom: 2px;
  }
  .kick-kicker:hover { color: var(--accent-primary); }
  .kick-title {
    font-family: var(--font-display);
    font-weight: var(--font-semibold);
    font-size: var(--heading-md);
    line-height: var(--leading-tight);
    margin: 0 0 var(--space-sm);
  }
  .kick-title a { text-decoration: none; color: var(--text-primary); }
  .kick-title a:hover { color: var(--accent-primary); }
  .kick-desc { font-style: italic; color: var(--text-secondary); margin: 0 0 var(--space-md); }
  .kick-note { font-family: var(--font-body); line-height: var(--leading-relaxed); color: var(--text-secondary); }
  .kick-note :global(p) { margin: 0 0 var(--space-sm); }
  .kick-quote {
    margin: var(--space-md) 0 0;
    padding: var(--space-sm) var(--space-md);
    background: var(--gradient-primary-subtle);
    border-left: 3px solid var(--accent-secondary);
    color: var(--text-secondary);
  }
  .kick-quote p { margin: 0; }
  .kick-quote cite { display: block; margin-top: var(--space-xs); font-family: var(--font-mono); font-size: var(--text-xs); font-style: normal; }
  .kick-tags { margin: var(--space-md) 0 0; display: flex; gap: var(--space-sm); font-family: var(--font-mono); font-size: var(--text-xs); color: var(--text-secondary); }
  .kick-tags a { text-decoration: none; }
</style>
