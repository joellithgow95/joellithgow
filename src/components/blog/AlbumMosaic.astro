---
/**
 * AlbumMosaic — liked songs as a grid of album covers; an album with more
 * liked songs gets a bigger cover. The markup is src/lib/slice-html.ts, shared
 * with the live editor's draft preview, so the styles are global.
 */
import type { MosaicSong } from '@lib/album-mosaic';
import { albumMosaicHtml } from '@lib/slice-html';

export interface Props {
  songs: MosaicSong[];
}
---

<Fragment set:html={albumMosaicHtml(Astro.props.songs)} />

<style is:global>
  @import '../../styles/tokens.css';

  .spotify-cover-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, 76px);
    grid-auto-rows: 76px;
    grid-auto-flow: dense;
    gap: var(--space-xs);
    justify-content: start;
  }
  .spotify-cover-grid .cover-cell {
    display: block;
    overflow: hidden;
    border: 1px solid var(--gradient-primary-subtle);
    transition: transform var(--duration-base) var(--ease-out);
  }
  .spotify-cover-grid .cover-cell[data-span="2"] { grid-column: span 2; grid-row: span 2; }
  .spotify-cover-grid .cover-cell[data-span="3"] { grid-column: span 3; grid-row: span 3; }
  .spotify-cover-grid .cover-cell img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .spotify-cover-grid .cover-cell:hover {
    transform: scale(1.05);
    z-index: 1;
    position: relative;
  }
</style>
