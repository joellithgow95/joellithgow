---
/**
 * TopTags — "I post about #tag #tag …": the most-used tags on the blog,
 * as a line above the feed.
 *
 * Counts published posts only (what fetchBlogPosts() returns), so the
 * numbers match /blog/tags and the "N posts" heading on each tag page.
 * Definitions and links are data, not posts, and aren't counted.
 *
 * Usage:
 *   <TopTags posts={allPosts} />
 */
import Badge from '@components/primitives/Badge.astro';

export interface Props {
  posts: { tags?: string[] }[];
  limit?: number;
}

const { posts, limit = 12 } = Astro.props;

const counts = new Map<string, number>();
for (const post of posts) {
  for (const tag of new Set(post.tags ?? [])) counts.set(tag, (counts.get(tag) ?? 0) + 1);
}
// Most used first, then alphabetical, same order as /blog/tags
const sorted = [...counts.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
const top = sorted.slice(0, limit);
---

{top.length > 0 && (
  <nav class="top-tags" aria-label="Top tags">
    <p class="tt-line">
      <span class="tt-label">I post about</span>
      {top.map(([tag, count]) => (
        <Badge
          variant="tag"
          size="sm"
          href={`/blog/tags/${tag}`}
          title={`${count} post${count !== 1 ? 's' : ''} tagged ${tag}`}
        >
          #{tag} <span class="tt-count">{count}</span>
        </Badge>
      ))}
      {sorted.length > top.length && (
        <a href="/blog/tags" class="tt-all">all {sorted.length} tags →</a>
      )}
    </p>
  </nav>
)}

<style>
  @import '../../styles/tokens.css';
  @import '../../styles/themes.css';

  /* Same measure and face as a post's paragraphs, so it wraps where they do */
  .top-tags {
    margin: 0 0 var(--space-lg) 0;
    padding-bottom: var(--space-lg);
    border-bottom: 1px solid var(--gradient-primary-subtle);
  }

  .tt-line {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-sm);
    max-width: 68ch;
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    color: var(--text-secondary);
  }

  .tt-label { color: var(--text-primary); }

  .tt-count { opacity: 0.6; }

  .tt-all {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-secondary);
    text-decoration: none;
  }
  .tt-all:hover { color: var(--accent-primary); }
</style>
