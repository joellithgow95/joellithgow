---
import BaseLayout from '@components/common/BaseLayout.astro';
import ThemeModal from '@components/modals/ThemeModal.astro';
import ThemeConstellation from '@components/theme/ThemeConstellation.astro';
import SoundToggle from '@components/theme/SoundToggle.astro';
import Card from '@components/primitives/Card.astro';

const pageTitle = 'Joel Lithgow - Creative Technologist';
const pageDescription = 'Creative technologist who builds things and writes about them. View my professional work or read my writing.';
---

<BaseLayout title={pageTitle} description={pageDescription} showGlobalHeader={false}>
  <main class="landing-page">
    <div class="landing-content">
      <div class="landing-grid">
        <!-- Left Column: Name + Bio -->
        <div class="landing-left">
          <header class="landing-header">
            <h1 class="name">Joel Lithgow</h1>
          </header>

          <div class="bio-section">
            <p class="bio-text">
              A 27-year-old Australian-American nerd with a BFA in Art and Design from California College of the Arts.
            </p>
            <a href="/about" class="about-cta">
              Learn more about me →
            </a>
          </div>

          <!-- Theme picker constellation (replaces the floating toggle here) -->
          <div class="theme-picker">
            <ThemeConstellation />
            <SoundToggle />
          </div>
        </div>

        <!-- Right Column: Navigation Cards -->
        <nav class="landing-nav" aria-label="Main sections">
          <Card variant="alternating" href="/work" class="nav-card">
            <span class="card-title">Portfolio</span>
            <span class="card-description">What I do as a creative technologist</span>
            <span class="card-arrow" aria-hidden="true">→</span>
          </Card>

          <Card variant="alternating" href="/blog" class="nav-card">
            <span class="card-title">Blog</span>
            <span class="card-description">I guess this is my social media</span>
            <span class="card-arrow" aria-hidden="true">→</span>
          </Card>

          <Card variant="alternating" href="/artworks" class="nav-card">
            <span class="card-title">Artwork</span>
            <span class="card-description">Things I make for myself</span>
            <span class="card-arrow" aria-hidden="true">→</span>
          </Card>

          <Card variant="alternating" href="https://thisisahousegallery.com" class="nav-card">
            <span class="card-title">This is a House Gallery</span>
            <span class="card-description">This is also my house lol</span>
            <span class="card-arrow" aria-hidden="true">→</span>
          </Card>

          <Card variant="alternating" href="https://divebarnranch.com" class="nav-card">
            <span class="card-title">Dive Barn</span>
            <span class="card-description">An arts and music event I ran</span>
            <span class="card-arrow" aria-hidden="true">→</span>
          </Card>
        </nav>
      </div>
    </div>
  </main>

  <!-- Theme Modal -->
  <ThemeModal />
</BaseLayout>

<style>
  @import '../styles/tokens.css';
  @import '../styles/themes.css';
  @import '../styles/backgrounds.css';

  .landing-page {
    min-height: 100vh;
    color: var(--text-primary);
    font-family: var(--font-body);
    padding: var(--space-3xl) var(--page-gutter);
    position: relative;
    overflow: hidden; /* Required for animated backgrounds */
  }

  .landing-content {
    max-width: var(--content-normal);
    margin: 0 auto;
    width: 100%;
    padding-top: var(--space-4xl);
    position: relative;
    z-index: 10; /* Above animated backgrounds */
  }

  .landing-grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-4xl);
  }

  .landing-left {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    width: 100%;
  }

  .landing-header {
    margin-bottom: 0;
    width: 100%;
    text-align: center;
  }

  .name {
    font-family: var(--font-display);
    /* Pin the optical size: at ~100px, auto optical sizing selects Fraunces'
       high-contrast display cut with hairline-thin serifs, which reads too
       delicate here. `none` uses the sturdier default optical size. */
    font-optical-sizing: none;
    font-size: clamp(40px, 8vw, 100px);
    font-weight: var(--font-semibold);
    letter-spacing: var(--tracking-tight);
    line-height: 1;
    margin: 0;
    color: var(--text-primary);
    display: inline-block;
  }

  .landing-nav {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-xl);
  }

  /* Custom nav card styling */
  /* Scoped under .landing-nav so these win over Card's own utility
     classes (card--radius-lg / card--padding-lg). Both are single-class
     = equal specificity, so without this the winner depends on stylesheet
     load order — which flashes (sharp → rounded) as Card's CSS arrives. */
  .landing-nav .nav-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    padding: var(--space-2xl) var(--space-xl);
    position: relative;
    border-radius: 0; /* sharp brutalist corners, matching the blog cards */
    transition: transform var(--duration-slow) var(--ease-out),
                box-shadow var(--duration-slow) var(--ease-out);
  }

  .landing-nav .nav-card:hover {
    z-index: 5;
  }

  /* First 3 cards (primary) get more padding */
  .nav-card:nth-child(1),
  .nav-card:nth-child(2),
  .nav-card:nth-child(3) {
    padding: var(--space-3xl) var(--space-2xl);
  }

  .card-title {
    display: block;
    font-family: var(--font-display);
    font-optical-sizing: auto;
    font-size: clamp(32px, 6vw, 60px);
    font-weight: var(--font-semibold);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    margin-bottom: var(--space-sm);
  }

  /* First 3 cards get huge titles like the main heading */
  .nav-card:nth-child(1) .card-title,
  .nav-card:nth-child(2) .card-title,
  .nav-card:nth-child(3) .card-title {
    font-size: clamp(40px, 8vw, 100px);
  }

  .card-description {
    display: block;
    font-family: var(--font-body);
    font-size: clamp(1.125rem, 3vw, 1.875rem);
    font-weight: var(--font-medium);
    line-height: var(--leading-relaxed);
  }

  .card-arrow {
    position: absolute;
    right: var(--space-2xl);
    top: 50%;
    transform: translateY(-50%);
    font-size: var(--text-3xl);
    opacity: 0.7;
    transition: all var(--duration-base) var(--ease-out);
  }

  .nav-card:hover .card-arrow {
    opacity: 1;
    transform: translateY(-50%) translateX(8px);
  }

  .bio-section {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    align-items: center;
    text-align: center;
    margin-top: var(--space-xl);
  }

  .bio-text {
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    color: var(--text-secondary);
    margin: 0;
    max-width: 400px;
  }

  /* CTA styling - matches project-cta on /work */
  .about-cta {
    display: inline-block;
    font-family: var(--font-family);
    font-size: var(--text-base);
    font-weight: var(--font-bold);
    color: var(--text-light);
    text-decoration: none;
    padding: var(--button-padding-y) var(--button-padding-x);
    background: var(--accent-primary);
    border: var(--border-width-thick) solid var(--bg-dark);
    box-shadow: var(--shadow-md) var(--bg-dark);
    transition: transform var(--duration-slow) var(--ease-out),
                box-shadow var(--duration-slow) var(--ease-out);
  }

  .about-cta:hover {
    transform: translate(-2px, -2px);
    box-shadow: var(--shadow-lg) var(--bg-dark);
  }

  .about-cta:focus {
    outline: var(--border-width-thick) solid var(--accent-primary);
    outline-offset: var(--space-xs);
  }

  /* Theme picker constellation — sits under the bio */
  .theme-picker {
    margin-top: var(--space-2xl);
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-md);
  }

  /* Mobile adjustments */
  @media (max-width: 768px) {
    .landing-page {
      padding: var(--space-xl) var(--page-gutter);
    }

    .landing-content {
      padding-top: var(--space-2xl);
    }

    .name {
      font-size: clamp(36px, 8vw, 80px);
    }

    .landing-nav {
      gap: var(--space-lg);
    }

    .landing-nav .nav-card {
      padding: var(--space-xl) var(--space-lg);
    }

    .nav-card:nth-child(1),
    .nav-card:nth-child(2),
    .nav-card:nth-child(3) {
      padding: var(--space-2xl) var(--space-xl);
    }

    .nav-card:nth-child(even) {
      transform: rotate(1deg);
    }
  }

  @media (max-width: 480px) {
    .landing-page {
      padding: var(--space-lg) var(--space-md);
    }

    .landing-content {
      padding-top: var(--space-xl);
    }

    .landing-nav .nav-card {
      padding: var(--space-lg) var(--space-md);
    }

    .nav-card:nth-child(1),
    .nav-card:nth-child(2),
    .nav-card:nth-child(3) {
      padding: var(--space-xl) var(--space-lg);
    }

    .card-title {
      font-size: clamp(28px, 6vw, 48px);
    }

    .nav-card:nth-child(1) .card-title,
    .nav-card:nth-child(2) .card-title,
    .nav-card:nth-child(3) .card-title {
      font-size: clamp(36px, 8vw, 80px);
    }

    .card-arrow {
      right: var(--space-lg);
      font-size: var(--text-2xl);
    }
  }

  /* Desktop layout - Two columns */
  @media (min-width: 1024px) {
    .landing-page {
      min-height: 100vh;
      padding: 0;
    }

    .landing-content {
      max-width: none;
      padding: var(--space-3xl) 0 var(--space-3xl) 0;
      width: 100%;
      min-height: 100vh;
    }

    .landing-grid {
      display: block;
      min-height: 100vh;
    }

    .landing-left {
      position: fixed;
      left: 0;
      top: 0;
      width: 35%;
      height: 100vh;
      display: flex;
      flex-direction: column;
      gap: var(--space-sm);
      overflow: hidden;
      justify-content: flex-start;
      padding: var(--space-4xl) 0 var(--space-4xl) var(--page-gutter);
    }

    .landing-header {
      margin-bottom: 0;
      text-align: left;
    }

    .bio-section {
      align-items: flex-start;
      text-align: left;
      margin-top: var(--space-xl);
    }

    /* Left-align the theme picker under the name/bio/CTA */
    .theme-picker {
      justify-content: flex-start;
    }

    .bio-text {
      font-size: var(--text-lg);
    }

    .landing-nav {
      margin-left: 35%;
      display: flex;
      flex-direction: column;
      gap: var(--space-2xl);
      padding: var(--space-3xl) var(--page-gutter) var(--space-3xl) var(--space-4xl);
      min-height: 100vh;
    }
  }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .name,
    .nav-card,
    .card-arrow {
      transition: none;
      transform: none;
    }
  }
</style>
