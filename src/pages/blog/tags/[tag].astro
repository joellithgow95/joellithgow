---
import { fetchBlogPosts } from '@lib/astraeus';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '@components/common/BaseLayout.astro';
import ThemeModal from '@components/modals/ThemeModal.astro';
import UIInteractions from '@components/interactive/UIInteractions.astro';
import KeyboardShortcuts from '@components/interactive/KeyboardShortcuts.astro';
import PerformanceOptimizer from '@components/ui/PerformanceOptimizer.astro';
import Badge from '@components/primitives/Badge.astro';
import Button from '@components/primitives/Button.astro';
import LinksAccordion from '@components/blog/LinksAccordion.astro';
import { loadDataPool, resolveSlices } from '@lib/slices';
import '../../../styles/log.css';

export const getStaticPaths = (async () => {
  const allPosts = await fetchBlogPosts();

  // Get all unique tags from posts
  const allTags = new Set<string>();
  allPosts.forEach((post) => {
    post.tags?.forEach((tag) => allTags.add(tag));
  });

  // Also get tags from link documents
  const { links: allLinks } = await loadDataPool();
  allLinks.forEach((link) => link.tags?.forEach((tag) => allTags.add(tag)));

  // What a post's slices show, as "N tracks" / "N obs", for its row's count
  const sliceCount = new Map<string, string>();
  for (const post of allPosts) {
    const resolved = await resolveSlices((post as any).data);
    const songs = resolved.reduce((n, r) => n + (r.kind === 'music' ? r.songs.length : 0), 0);
    const obs = resolved.reduce((n, r) => n + (r.kind === 'nature' ? r.observations.length : 0), 0);
    const links = resolved.reduce((n, r) => n + (r.kind === 'links' ? r.links.length : 0), 0);
    if (songs) sliceCount.set(post.slug, `${songs} tracks`);
    else if (obs) sliceCount.set(post.slug, `${obs} obs`);
    else if (links) sliceCount.set(post.slug, `${links} links`);
  }

  // Create a path for each tag
  return Array.from(allTags).map((tag) => {
    const postsWithTag = allPosts
      .filter((post) => post.tags?.includes(tag))
      .sort((a, b) => new Date(b.publish_date).valueOf() - new Date(a.publish_date).valueOf());

    // Link documents with this tag, newest first
    const linksWithTag = allLinks
      .filter((link) => link.tags?.includes(tag))
      .sort((a, b) => b.date_added.localeCompare(a.date_added));

    return {
      params: { tag },
      props: { posts: postsWithTag, links: linksWithTag, tag, sliceCount },
    };
  });
}) satisfies GetStaticPaths;

const { posts, links, tag, sliceCount } = Astro.props;

const pageTitle = `Posts tagged "${tag}"`;
const pageDescription = `All blog posts tagged with ${tag}.`;
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <main class="blog-container">
    <div class="blog-wrapper blog-wrapper--full">
      <div class="main-content">
        {/* Back navigation */}
        <nav class="breadcrumb-nav">
          <Button href="/blog" variant="ghost" size="sm">← Back to Blog</Button>
        </nav>

        <header class="section-head">
          <h1 class="section-title">#{tag}</h1>
          <p class="section-desc">{pageDescription}</p>
        </header>

        <section class="tag-posts-section">
          <h2 class="section-heading">
            {posts.length} {posts.length === 1 ? 'post' : 'posts'}
            {links.length > 0 && <span class="section-heading-separator">•</span>}
            {links.length > 0 && <span>{links.length} {links.length === 1 ? 'link' : 'links'}</span>}
          </h2>
          <div class="log-feed">
            {posts.map((post) => {
              const href = `/blog/${post.slug}`;
              const count = sliceCount.get(post.slug) ?? null;
              return (
                <article class="log-item">
                  <time class="log-date" datetime={new Date(post.publish_date).toISOString()}>
                    {new Date(post.publish_date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
                  </time>

                  <h3 class="log-title">
                    <a href={href}>{post.title}</a>
                    {count && <span class="log-count">{count}</span>}
                  </h3>

                  {post.description && (
                    <p class="log-desc">{post.description}</p>
                  )}

                  {post.tags && post.tags.length > 0 && (
                    <div class="log-tags">
                      {post.tags.map((postTag) => (
                        <Badge href={`/blog/tags/${postTag}`} size="sm" class:list={{ 'is-current': postTag === tag }}>#{postTag}</Badge>
                      ))}
                    </div>
                  )}
                </article>
              );
            })}
          </div>
        </section>

        {/* Links carrying this tag — same accordion as the links page */}
        {links.length > 0 && (
          <section class="tag-links-section">
            <h2 class="section-heading">Links</h2>
            <LinksAccordion links={links} />
          </section>
        )}
      </div>
    </div>
  </main>

  <!-- Theme Modal -->
  <ThemeModal />

  <!-- Enhanced UI Interactions -->
  <UIInteractions />

  <!-- Keyboard Shortcuts and Accessibility -->
  <KeyboardShortcuts />

  <!-- Performance Optimization and Monitoring -->
  <PerformanceOptimizer />

  <!-- Theme toggle button -->
  <Button
    variant="ghost"
    size="md"
    id="themeControl"
    class="theme-toggle-button"
    onclick="window.openThemeModal && window.openThemeModal()"
    aria-label="Change theme"
    title="Change theme (Ctrl+T)"
  >
    🎨
  </Button>
</BaseLayout>

<style>
  @import '../../../styles/tokens.css';
  @import '../../../styles/themes.css';
  @import '../../../styles/backgrounds.css';

    /* Definition preview in tag feed */
    .definition-preview {
      margin: var(--space-lg) 0;
      padding: var(--space-md) var(--space-lg);
      background: var(--bg-secondary);
      border-left: 3px solid var(--accent-primary);
      font-style: italic;
      color: var(--text-secondary);
      font-size: var(--text-base);
      line-height: var(--leading-relaxed);
    }

    .definition-preview p {
      margin: 0;
    }

    /* Page chrome (.blog-container/.blog-wrapper/.main-content/.section-head)
     comes from log.css; the container is transparent so the grid shows through. */

  /* Breadcrumb navigation */
  .breadcrumb-nav {
    margin-bottom: var(--space-xl);
  }

  .tag-posts-section {
    position: relative;
    margin: var(--space-xl) 0;
  }

  .section-heading {
    font-size: var(--heading-lg);
    font-weight: var(--font-bold);
    color: var(--text-primary);
    margin: 0 0 var(--space-xl) 0;
    letter-spacing: var(--tracking-tight);
  }

  .section-heading-separator {
    margin: 0 var(--space-sm);
    color: var(--text-secondary);
  }

  /* ---- Post feed — compact field-journal rows with hairline dividers ---- */
  .log-feed {
    display: flex;
    flex-direction: column;
  }

  .log-item {
    padding: var(--space-lg) 0;
    border-top: 1px solid var(--gradient-primary-subtle);
  }
  .log-item:first-child { border-top: none; padding-top: 0; }

  .log-date {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--text-secondary);
    margin-bottom: var(--space-xs);
  }

  .log-title {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--space-sm);
    font-family: var(--font-display);
    font-optical-sizing: auto;
    font-weight: var(--font-semibold);
    font-size: var(--heading-md);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    color: var(--text-primary);
    margin: 0 0 var(--space-sm) 0;
  }
  .log-title a {
    color: var(--text-primary);
    text-decoration: none;
    transition: color var(--duration-base) var(--ease-out);
  }
  .log-title a:hover { color: var(--accent-primary); }

  .log-count {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: var(--font-normal);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--text-secondary);
  }

  .log-desc {
    font-family: var(--font-body);
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    color: var(--text-secondary);
    max-width: 68ch;
    margin: 0 0 var(--space-sm) 0;
  }

  /* Quiet mono outline chips, matching the dictionary index */
  .log-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }
  .log-tags :global(.badge) {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: var(--font-normal);
    text-transform: none;
    letter-spacing: 0;
    color: var(--text-secondary);
    background: none;
    border: 1px solid var(--gradient-primary-subtle);
    border-radius: var(--radius-sm);
    box-shadow: none;
    padding: 1px var(--space-sm);
  }
  .log-tags :global(.badge:hover) {
    color: var(--text-primary);
    border-color: var(--accent-primary);
    background: none;
  }
  /* The tag being viewed reads as a filled accent chip so it stands out */
  .log-tags :global(.badge.is-current) {
    color: var(--card-alt-text-1);
    background: var(--accent-primary);
    border-color: var(--accent-primary);
  }

  /* Links section — rows rendered by the shared LinksAccordion component */
  .tag-links-section {
    margin-top: var(--space-3xl);
    padding-top: var(--space-2xl);
    border-top: 2px solid var(--text-primary);
  }
  .tag-links-section .section-heading {
    margin-bottom: var(--space-md);
  }

  /* Theme toggle button */
  .theme-toggle-button {
    position: fixed;
    bottom: var(--space-xl);
    right: var(--space-xl);
    width: 48px;
    height: 48px;
    border-radius: var(--radius-full);
    z-index: var(--z-sticky);
  }

  @media (max-width: 768px) {
    .theme-toggle-button {
      bottom: var(--space-lg);
      right: var(--space-lg);
      width: 44px;
      height: 44px;
    }
  }
</style>
