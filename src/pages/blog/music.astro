---
import BaseLayout from '@components/common/BaseLayout.astro';
import ThemeModal from '@components/modals/ThemeModal.astro';
import AlbumMosaic from '@components/blog/AlbumMosaic.astro';
import { fetchBlogPosts } from '@lib/astraeus';
import type { MosaicSong } from '@lib/album-mosaic';
import { loadDataPool, postsByItem, postsShowing, type PostRef, type Song } from '@lib/slices';
import '../../styles/log.css';

// Every liked song, by the month it was liked, newest first; each month links
// to the posts that show its songs.
type Month = { key: string; songs: MosaicSong[]; posts: PostRef[] };

const allPosts = await fetchBlogPosts();
const { songs } = await loadDataPool();
const byItem = await postsByItem(allPosts.filter((p) => p.kind === 'post') as any);

const grouped = new Map<string, Song[]>();
for (const song of songs) {
  const key = song.liked_at.slice(0, 7);
  grouped.set(key, [...(grouped.get(key) ?? []), song]);
}
const months: Month[] = [...grouped.entries()].map(([key, monthSongs]) => ({
  key,
  songs: monthSongs,
  posts: postsShowing(monthSongs.map((s) => s._id), byItem),
}));
months.sort((a, b) => b.key.localeCompare(a.key));
const monthLabel = (key: string) =>
  new Date(`${key}-01T00:00:00Z`).toLocaleDateString('en-US', { year: 'numeric', month: 'long', timeZone: 'UTC' });

// Featured Spotify links (share ?si= params stripped).
const spotifyLinks = [
  { label: 'Rock Lover', href: 'https://open.spotify.com/playlist/37W20LgdrwREsmw4n3LdHT', tone: 'primary' },
  { label: 'My GFs Band', href: 'https://open.spotify.com/album/58oxh42Rd414O6ineUu3Et', tone: 'secondary' },
  { label: 'My friends band', href: 'https://open.spotify.com/artist/0RCkt4wVqkCX00T7ITXIzp', tone: 'tertiary' },
  { label: 'Aussie Stuff', href: 'https://open.spotify.com/playlist/4gS9JLYd16rUV4pWhEXj6P', tone: 'primary' },
];

const pageTitle = 'Joel Lithgow > Music';
const pageDescription = "What I've been listening to: every liked song, month by month.";
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <main class="blog-container">
    <div class="blog-wrapper">
      <div class="main-content">
        <header class="section-head">
          <h1 class="section-title">Music</h1>
          <p class="section-desc">{pageDescription}</p>
        </header>

        {months.length > 0 ? (
          <div class="music-list">
            {months.map((month) => (
              <article class="music-dump">
                <h2 class="music-dump-title">
                  {monthLabel(month.key)}
                </h2>
                <AlbumMosaic songs={month.songs} />
                <p class="music-dump-meta">
                  {month.songs.length} song{month.songs.length !== 1 ? 's' : ''}
                </p>
                <details class="music-dump-songs">
                  <summary>All songs</summary>
                  <ol>
                    {month.songs.map((song) => (
                      <li>
                        {song.spotify_url ? <a href={song.spotify_url} target="_blank" rel="noopener noreferrer">{song.track_name}</a> : song.track_name}
                        {song.artist_name && <span> · {song.artist_name}</span>}
                      </li>
                    ))}
                  </ol>
                </details>
              </article>
            ))}
          </div>
        ) : (
          <p class="section-empty">No liked songs yet.</p>
        )}
      </div>

      <aside class="sidebar">
        <h2 class="sidebar-heading">On Spotify</h2>
        <nav class="type-nav" aria-label="Spotify links">
          {spotifyLinks.map((l) => (
            <a href={l.href} target="_blank" rel="noopener noreferrer" class:list={['type-card', `type-card--${l.tone}`]}>
              <span class="tc-label">{l.label}</span>
              <span class="tc-arrow" aria-hidden="true">↗</span>
            </a>
          ))}
        </nav>
      </aside>
    </div>
  </main>

  <ThemeModal />
</BaseLayout>

<style>
  @import '../../styles/tokens.css';
  @import '../../styles/themes.css';

  /* Section header + breadcrumb come from log.css */
  .music-list { display: flex; flex-direction: column; gap: var(--space-xl); }
  .music-dump {
    border-top: 1px solid var(--gradient-primary-subtle);
    padding-top: var(--space-lg);
  }
  .music-dump:first-child { border-top: none; padding-top: 0; }
  .music-dump-title {
    font-family: var(--font-display);
    font-optical-sizing: auto;
    font-weight: var(--font-semibold);
    font-size: var(--heading-md);
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-tight);
    margin: 0 0 var(--space-sm) 0;
  }
  .music-dump-title a { color: var(--text-primary); text-decoration: none; }
  .music-dump-title a:hover { color: var(--accent-primary); }
  .music-dump-meta { font-size: var(--text-xs); color: var(--text-secondary); margin: var(--space-xs) 0 0 0; }
  .music-dump-meta a { color: var(--text-secondary); }
  .music-dump-meta a:hover { color: var(--accent-primary); }
  .music-dump-songs { margin-top: var(--space-xs); font-size: var(--text-sm); color: var(--text-secondary); }
  .music-dump-songs summary { cursor: pointer; }
  .music-dump-songs ol { margin: var(--space-xs) 0 0 0; padding-left: var(--space-lg); }
  .music-dump-songs a { color: var(--text-primary); }
</style>
