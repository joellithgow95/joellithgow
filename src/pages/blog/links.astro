---
import { fetchBlogPosts, fetchDefinitions } from '@lib/astraeus';
import { loadDataPool, resolveSlices } from '@lib/slices';
import LinksAccordion from '@components/blog/LinksAccordion.astro';
import BaseLayout from '@components/common/BaseLayout.astro';
import ThemeModal from '@components/modals/ThemeModal.astro';
import UIInteractions from '@components/interactive/UIInteractions.astro';
import KeyboardShortcuts from '@components/interactive/KeyboardShortcuts.astro';
import PerformanceOptimizer from '@components/ui/PerformanceOptimizer.astro';
import Card from '@components/primitives/Card.astro';
import Badge from '@components/primitives/Badge.astro';
import Button from '@components/primitives/Button.astro';
import '../../styles/log.css';

// Every published link document
const { links: linkDocs } = await loadDataPool();

// Posts whose slices show links, for the sidebar, with how many each shows
const allPosts = await fetchBlogPosts();
const collections = (
  await Promise.all(
    allPosts
      .filter(p => p.kind === 'post')
      .map(async post => ({
        post,
        count: (await resolveSlices((post as any).data))
          .reduce((n, r) => n + (r.kind === 'links' ? r.links.length : 0), 0),
      })),
  )
)
  .filter(c => c.count > 0)
  .sort((a, b) => new Date(b.post.publish_date).valueOf() - new Date(a.post.publish_date).valueOf());

// Get all definitions that have link sources
const allDefinitions = await fetchDefinitions();
const defsWithLinkSources = allDefinitions.filter(
  d => d.sources && d.sources.some(s => s.type === 'link')
);

const postLinks = linkDocs.map(link => ({
  url: link.url,
  title: link.title,
  description: link.description ?? '',
  date_added: link.date_added,
}));

// Aggregate all link sources from definitions
const definitionLinks = defsWithLinkSources.flatMap(def =>
  (def.sources ?? []).filter(s => s.type === 'link').map(source => ({
    url: source.url ?? '',
    title: source.title ?? 'Untitled',
    description: source.description ?? '',
    date_added: def.publish_date,
  }))
);

// Combine all links
const allLinks = [...postLinks, ...definitionLinks];

// Sort links by date added (newest first)
const sortedLinks = allLinks.sort(
  (a, b) => new Date(b.date_added).valueOf() - new Date(a.date_added).valueOf()
);

// Get some stats
const totalLinks = allLinks.length;
const totalPostSources = collections.length;
const totalDefinitionSources = defsWithLinkSources.length;
const totalSources = totalPostSources + totalDefinitionSources;

const pageTitle = "Link Collection";
const pageDescription = `Browse all ${totalLinks} links from ${totalSources} posts and definitions. Discover curated resources, tools, and interesting finds.`;
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <main class="blog-container">
    <div class="blog-wrapper">
      {/* Main Content Column */}
      <div class="main-content">
        <header class="section-head">
          <h1 class="section-title">Links</h1>
          <p class="section-desc">{pageDescription}</p>
        </header>

        {/* Links list — slim accordion rows; expand for detail + preview */}
        {sortedLinks.length > 0 ? (
          <LinksAccordion links={sortedLinks} />
        ) : (
          <Card class="empty-state">
            <div class="empty-message">
              <Badge>coming soon</Badge>
              <p>No links found. Check back as we add more curated content!</p>
              <Button href="/blog">Browse blog posts →</Button>
            </div>
          </Card>
        )}
      </div>

      {/* Sidebar — link collections */}
      <aside class="sidebar">
        <h2 class="sidebar-heading">Collections</h2>
        {collections.length > 0 ? (
          <nav class="type-nav" aria-label="Link collections">
            {collections.map((c, i) => (
              <a href={`/blog/${c.post.slug}`} class:list={['type-card', `type-card--${['primary', 'secondary', 'tertiary'][i % 3]}`]}>
                <span class="tc-label">{c.post.title}</span>
                <span class="tc-count">{c.count}</span>
                <span class="tc-arrow" aria-hidden="true">→</span>
              </a>
            ))}
          </nav>
        ) : (
          <p class="sidebar-empty">No collections yet.</p>
        )}
      </aside>
    </div>
  </main>

  <!-- Theme Modal -->
  <ThemeModal />

  <!-- Enhanced UI Interactions -->
  <UIInteractions />

  <!-- Keyboard Shortcuts and Accessibility -->
  <KeyboardShortcuts />

  <!-- Performance Optimization and Monitoring -->
  <PerformanceOptimizer />

  <!-- Theme toggle button -->
  <Button
    variant="ghost"
    size="md"
    id="themeControl"
    class="theme-toggle-button"
    onclick="window.openThemeModal && window.openThemeModal()"
    aria-label="Change theme"
    title="Change theme (Ctrl+T)"
  >
    🎨
  </Button>

</BaseLayout>

<style>
  @import '../../styles/tokens.css';
  @import '../../styles/themes.css';
  @import '../../styles/backgrounds.css';

  /* Page chrome (.blog-container/.blog-wrapper/.main-content/.sidebar) is in log.css */

  /* Section header comes from log.css; scorecard removed */


  .empty-state {
    text-align: center;
    padding: var(--space-4xl) var(--space-xl);
    margin-top: var(--space-xl);
  }

  .empty-message :global(.badge) {
    margin-bottom: var(--space-md);
  }

  .empty-message p {
    font-size: var(--text-lg);
    color: var(--text-secondary);
    margin: var(--space-md) 0;
  }

  /* Theme toggle button */
  .theme-toggle-button {
    position: fixed;
    bottom: var(--space-xl);
    right: var(--space-xl);
    width: 48px;
    height: 48px;
    border-radius: var(--radius-full);
    z-index: var(--z-sticky);
  }

  /* Responsive design (wrapper/sidebar stacking handled by log.css) */
  @media (max-width: 768px) {
    .blog-container {
      padding: var(--space-xl) var(--page-gutter);
    }

    .theme-toggle-button {
      bottom: var(--space-lg);
      right: var(--space-lg);
      width: 44px;
      height: 44px;
    }
  }

  @media (max-width: 480px) {
    .blog-container {
      padding: var(--space-lg) var(--space-md);
    }
  }
</style>
