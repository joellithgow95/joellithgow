---
import { marked } from 'marked';
import type { GetStaticPaths } from 'astro';
import { fetchBlogPosts, fetchDefinitions } from '@lib/astraeus';
import BaseLayout from '@components/common/BaseLayout.astro';
import ThemeModal from '@components/modals/ThemeModal.astro';
import UIInteractions from '@components/interactive/UIInteractions.astro';
import KeyboardShortcuts from '@components/interactive/KeyboardShortcuts.astro';
import PerformanceOptimizer from '@components/ui/PerformanceOptimizer.astro';
import Card from '@components/primitives/Card.astro';
import Badge from '@components/primitives/Badge.astro';
import Button from '@components/primitives/Button.astro';
import PageTitle from '@components/ui/PageTitle.astro';
import Video from '@components/ui/Video.astro';
import ImageGallery from '@components/modals/ImageGallery.astro';
import AlbumMosaic from '@components/blog/AlbumMosaic.astro';
import PostSlices from '@components/blog/slices/PostSlices.astro';
import { loadDataPool, resolveSlices, type Entry } from '@lib/slices';

export const getStaticPaths = (async () => {
  const posts = await fetchBlogPosts();
  const sorted = posts.sort(
    (a, b) => new Date(b.publish_date).valueOf() - new Date(a.publish_date).valueOf()
  );

  // Bucket posts into quarters, e.g. "2026-q3". Use UTC: publish dates are
  // stored as UTC midnight (e.g. 2024-07-01), and local time would roll
  // first-of-month dates back into the previous quarter (and Jan → prev year).
  const quarterKey = (d: Date) => `${d.getUTCFullYear()}-q${Math.floor(d.getUTCMonth() / 3) + 1}`;
  const buckets = new Map<string, typeof sorted>();
  for (const post of sorted) {
    const key = quarterKey(new Date(post.publish_date));
    if (!buckets.has(key)) buckets.set(key, []);
    buckets.get(key)!.push(post);
  }

  // Newest→oldest quarter keys. Latest quarter lives at /blog; rest at /blog/<key>.
  const keysDesc = Array.from(buckets.keys()).sort().reverse();
  const period = (key: string) => {
    const [y, q] = key.split('-q');
    return { key, year: Number(y), quarter: Number(q), label: `Q${q} ${y}`, href: key === keysDesc[0] ? '/blog' : `/blog/${key}` };
  };
  // Full timeline for the navigator, oldest→newest (left→right).
  const timeline = [...keysDesc].reverse().map((key) => ({ ...period(key), count: buckets.get(key)!.length }));

  return keysDesc.map((key, i) => ({
    params: { page: i === 0 ? undefined : key },
    props: {
      posts: buckets.get(key)!,
      currentKey: key,
      timeline,
      isLatest: i === 0,
    },
  }));
}) satisfies GetStaticPaths;

const { posts, currentKey, timeline, isLatest } = Astro.props;

// Group the full timeline into per-year blocks. The ←/→ buttons page through
// the years client-side (no navigation); only clicking a Q# loads that quarter.
const blockKey = (year: number) => year;
const blocks = new Map<number, typeof timeline>();
for (const p of timeline) {
  const bs = blockKey(p.year);
  if (!blocks.has(bs)) blocks.set(bs, []);
  blocks.get(bs)!.push(p);
}
const blockStarts = Array.from(blocks.keys()).sort((a, b) => a - b); // oldest → newest
const currentBlockIndex = blockStarts.indexOf(blockKey(Number(currentKey.split('-q')[0])));

// Get all posts for sidebar stats (need full collection, not just current page)
const allPosts = await fetchBlogPosts();

// A post whose Markdown body is at most this long, with no excerpt, shows in
// full on its feed card; a longer one is cut short, and its title leads to the rest.
const SHORT_BODY_CHARS = 800;

// The opening of a long post for its feed card: whole blocks (paragraphs,
// lists, quotes) up to about PREVIEW_CHARS of Markdown, so the card ends on a
// paragraph rather than mid-line. Code blocks and image-only paragraphs are
// left out (the card hides them anyway), and a first paragraph too long for
// the budget is cut at its last sentence that fits.
const PREVIEW_CHARS = 600;
function previewMarkdown(md: string): string {
  const blocks = marked.lexer(md).filter(
    (t) => t.type !== 'space' && t.type !== 'code' && t.type !== 'hr'
      && !(t.type === 'paragraph' && /^\s*(!\[[^\]]*\]\([^)]*\)\s*)+$/.test(t.raw)),
  );
  const kept: string[] = [];
  let used = 0;
  for (const t of blocks) {
    if (kept.length && used + t.raw.length > PREVIEW_CHARS) break;
    kept.push(t.raw.trim());
    used += t.raw.length;
  }
  // A heading with nothing after it reads as a dangling title
  while (kept.length > 1 && /^#{1,6}\s/.test(kept[kept.length - 1])) kept.pop();
  if (kept.length === 1 && used > PREVIEW_CHARS * 1.5) {
    const head = kept[0].slice(0, PREVIEW_CHARS);
    const cut = Math.max(head.lastIndexOf('. '), head.lastIndexOf('? '), head.lastIndexOf('! '));
    kept[0] = cut > PREVIEW_CHARS / 3 ? head.slice(0, cut + 1) : `${head.slice(0, head.lastIndexOf(' '))}…`;
  }
  return kept.join('\n\n');
}

// Each post's slices (ADR 026), resolved once for its feed card.
const slicesBySlug = new Map(
  await Promise.all(
    posts.map(async (post) => [post.slug, post.kind === 'post' ? await resolveSlices((post as any).data) : []] as const),
  ),
);

// How a post shows on the feed follows from what it holds (docs/blog-conventions.md):
// - A post whose only slice picks definitions, or one link, and that has no
//   body is a beat: a smaller title, no date, tagline or tags.
// - A post about one definition (or a definition beat) is titled with the
//   quoted term, and the definition sits right under the title.
// - A post whose only slice picks one link is titled with that link, which
//   links out with ↗; the slice itself is not drawn.
const onlyDefinitions = (slug: string) => {
  const s = slicesBySlug.get(slug) ?? [];
  return s.length === 1 && s[0].kind === 'definitions' ? s[0].definitions : null;
};
const onlyLink = (slug: string) => {
  const s = slicesBySlug.get(slug) ?? [];
  return s.length === 1 && s[0].kind === 'links' && !s[0].tag && s[0].links.length === 1 ? s[0].links[0] : null;
};

// A definition's credit, from its own sources: a link source links out with ↗
// (labelled with the source's title), a citation shows its attribution.
const esc = (t: string) => t.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/"/g, '&quot;');
const creditHtml = (d: Entry) => {
  const parts = (d.sources ?? []).map((src) =>
    src.type === 'link' && src.url
      ? `<a href="${esc(src.url)}" target="_blank" rel="noopener noreferrer">${esc(src.title || src.url)}</a>&nbsp;↗`
      : esc(src.attribution || src.title || ''),
  ).filter(Boolean);
  return parts.length ? `<span class="quote-credit">— ${parts.join(', ')}</span>` : '';
};
// A picked definition as a quote; `term` puts its term, linked to the dictionary, in front
const quoteHtml = (d: Entry, term: 'none' | 'plain' | 'linked') =>
  (term === 'linked' ? `<strong><a href="/blog/dictionary/${esc(d.slug)}">${esc(d.term)}</a></strong>: `
    : term === 'plain' ? `<strong>${esc(d.term)}</strong>: ` : '')
  + marked.parseInline(d.definition) + creditHtml(d);

// Published link documents; feeds the sidebar "Links" card
const totalLinks = (await loadDataPool()).links.length;

// Document-type counts for the "Browse" sidebar cards. Music and Birds count
// the posts that show songs or observations through a slice.
const hasSlice = (post: (typeof allPosts)[number], types: string[]) =>
  post.kind === 'post' && Array.isArray((post as any).data) && (post as any).data.some((s: any) => types.includes(s?.block_type));
const spotifyCount = allPosts.filter(post => hasSlice(post, ['music_range', 'music_picks'])).length;
const natureCount = allPosts.filter(post => hasSlice(post, ['nature_range', 'nature_picks'])).length;
// Definitions have no feed cards of their own; count the dictionary instead
const definitionCount = (await fetchDefinitions()).length;

// Sidebar: browse the log by document type (colored brutalist nav cards)
const typeNav = [
  { href: '/blog/links', label: 'Links', count: totalLinks, tone: 'secondary' },
  { href: '/blog/music', label: 'Music', count: spotifyCount, tone: 'tertiary' },
  { href: '/blog/nature', label: 'Birds', count: natureCount, tone: 'primary' },
  { href: '/blog/dictionary', label: 'Dictionary', count: definitionCount, tone: 'secondary' },
];

const pageTitle = "Joel Lithgow > Blog";
const pageDescription = "Silly ideas, shiny objects, and more things I share digitally";

// JSON-LD structured data for CollectionPage
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: pageTitle,
  description: pageDescription,
  url: 'https://joellithgow.com/blog',
  author: {
    '@type': 'Person',
    name: 'Joel Lithgow',
    url: 'https://joellithgow.com',
  },
  breadcrumb: {
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Home',
        item: 'https://joellithgow.com',
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Blog',
        item: 'https://joellithgow.com/blog',
      },
    ],
  },
};
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <main class="blog-container">
    <div class="blog-wrapper">
      {/* Main Content Column */}
      <div class="main-content">
        {posts.length > 0 && (
          <section id="blog" class="featured-posts-section">
            {/* data-cms-list + the template below let the editor show unpublished
                posts here while editing. Latest quarter only: that is where a new
                post would land. */}
            <div class="log-feed" data-cms-list={isLatest ? 'blog_post' : undefined}>
              {posts.map((post) => {
                // Blog posts (not gateway-synced dumps/outings) can be edited
                // inline from the index. data-cms-id scopes which document a
                // field edit belongs to.
                const isEditorial = post.kind === 'post';
                const body = ('body_markdown' in post ? (post as any).body_markdown : null) ?? '';
                const excerpt = ('excerpt' in post && (post as any).excerpt) || '';
                const linkCount = ('links' in post && (post as any).links?.length) || 0;
                // A short post shows its whole body on the card; a long one
                // shows its opening, and its title leads to the rest.
                const showsFullBody = !excerpt && SHORT_BODY_CHARS >= body.length;
                const postHref = `/blog/${post.slug}`;
                const pickedDefs = onlyDefinitions(post.slug);
                const pickedLink = onlyLink(post.slug);
                const isBeat = !!(pickedDefs || pickedLink) && !body.trim();
                const defTitle = pickedDefs && (pickedDefs.length === 1 || isBeat) ? pickedDefs : null;
                // The quote marks around a definition title are red
                const titleMarkup = defTitle
                  ? defTitle.map((x, i) => <>{i > 0 && ' / '}<span class="title-quote">“</span>{x.term}<span class="title-quote">”</span></>)
                  : post.title;
                return (
                <article
                  class="log-record"
                  data-size={isBeat ? 'beat' : undefined}
                  data-type={post.kind}
                  data-cms-id={isEditorial ? (post as any)._id : undefined}
                  data-cms-type={isEditorial ? 'blog_post' : undefined}
                >
                  <div class="record-body">
                    {!isBeat && <time class="record-date" datetime={new Date(post.publish_date).toISOString()}>
                      {new Date(post.publish_date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })}
                    </time>}
                  <Card variant="flat" as="article" class="featured-post-card" data-post-type={post.kind}>
                    <h2 class="post-title">
                      {isBeat && defTitle ? (
                        <span class="post-title-text">{titleMarkup}</span>
                      ) : (
                      pickedLink ? (
                      <a
                        href={pickedLink.url}
                        class="post-title-link"
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        <span>{titleMarkup}</span><span class="post-title-ext" aria-label="external link"> ↗</span>
                      </a>
                      ) : (
                        <span class="post-title-text" data-cms-field={defTitle ? undefined : 'title'}>{titleMarkup}</span>
                      )
                      )}
                      {linkCount > 0 && (
                        <Badge variant="tertiary" size="sm" class="collection-badge">{linkCount} links</Badge>
                      )}
                    </h2>

                    {/* Hero image/video */}
                    {'image' in post && (post as any).image && (
                      <div class="post-hero-image">
                        {(() => {
                          const img = (post as any).image;
                          const isVideo = img.type === 'video';
                          const linkHref = img.link;
                          const isExternal = img.link?.startsWith('http');

                          const media = isVideo ? (
                            <Video
                              src={img.src}
                              fallbackSrc={img.fallbackSrc}
                              poster={img.poster}
                              controls={false}
                            />
                          ) : (
                            <img
                              src={img.src}
                              alt={img.alt}
                              loading="lazy"
                            />
                          );

                          return linkHref ? (
                            <a
                              href={linkHref}
                              class="post-hero-link"
                              {...(isExternal ? { target: "_blank", rel: "noopener noreferrer" } : {})}
                            >
                              {media}
                            </a>
                          ) : media;
                        })()}
                      </div>
                    )}

                    {defTitle && defTitle.map((x) => (
                      <blockquote class="post-quote" set:html={quoteHtml(x, defTitle.length > 1 ? 'plain' : 'none')} />
                    ))}

                    {isBeat && pickedLink?.description && (
                      <div class="post-content-preview full-content"><p>{pickedLink.description}</p></div>
                    )}

                    {!isBeat && 'description' in post && (post as any).description && (
                      <p class="post-description" data-cms-field="description">
                        {(post as any).description}
                      </p>
                    )}

                    {/* Render excerpt or full content preview (blog posts only).
                        Editorial cards mark the preview as the body field, gated
                        behind an Expand toggle so the whole body is editable
                        inline without bloating the card for readers. */}
                    {isBeat ? null : excerpt ? (
                      <div class="post-excerpt-preview" set:html={excerpt}
                        data-cms-field={isEditorial ? 'body_markdown' : undefined}
                        data-cms-collapsible={isEditorial ? '' : undefined}
                      />
                    ) : (
                      <div class:list={['post-content-preview', { 'full-content': showsFullBody }]}
                        set:html={marked.parse(showsFullBody ? body : previewMarkdown(body))}
                        data-cms-field={isEditorial ? 'body_markdown' : undefined}
                        data-cms-collapsible={isEditorial ? '' : undefined}
                      />
                    )}

                    {pickedDefs && !defTitle && pickedDefs.map((x) => (
                      <blockquote class="post-quote" set:html={quoteHtml(x, 'linked')} />
                    ))}

                    {!pickedLink && !pickedDefs && <PostSlices slices={slicesBySlug.get(post.slug) ?? []} compact />}

                    {!isBeat && post.tags && post.tags.length > 0 && (
                      <div class="post-tags">
                        {post.tags.map((tag) => (
                          <Badge variant="tag" href={`/blog/tags/${tag}`} size="sm">#{tag}</Badge>
                        ))}
                      </div>
                    )}

                    {'reading_time' in post && (post as any).reading_time && (
                      <div class="post-meta">
                        <span class="post-reading-time">{(post as any).reading_time} min read</span>
                      </div>
                    )}
                  </Card>
                  </div>
                </article>
                );
              })}
            </div>
          </section>
        )}

        {/* Card prototype the editor copies for each unpublished post (see
            astraeus embed/drafts.js). Same markup and classes as the full post
            card above, so it is styled the same; data-cms-fill says which field
            fills which element. Never visible: <template> contents don't render. */}
        {isLatest && (
          <template data-cms-draft-template="blog_post">
            <article class="log-record" data-type="post">
              <div class="record-body">
                <time class="record-date" data-cms-fill="publish_date" data-cms-fill-format="date"></time>
                <Card variant="flat" as="article" class="featured-post-card" data-post-type="post">
                  <h2 class="post-title">
                    <span class="post-title-text" data-cms-field="title" data-cms-fill="title"></span>
                  </h2>
                  <p class="post-description" data-cms-field="description" data-cms-fill="description"></p>
                  <div
                    class="post-excerpt-preview"
                    data-cms-field="body_markdown"
                    data-cms-collapsible=""
                    data-cms-fill="body_markdown"
                    data-cms-fill-format="excerpt"
                  />
                </Card>
              </div>
            </article>
          </template>
        )}

        {/* Quarter timeline — ←/→ page through 2-year blocks (client-side); click a Q# to open it */}
        {timeline.length > 1 && (
          <nav class="q-nav" aria-label="Browse by quarter" data-q-nav data-block-index={currentBlockIndex}>
            <button type="button" class="q-arrow q-arrow--prev" data-q-prev aria-label="Show earlier quarters">←</button>
            <div class="q-track" data-q-track>
              {blockStarts.map((bs, bi) => (
                <div class="q-block" data-block={bi} hidden={bi !== currentBlockIndex}>
                  {blocks.get(bs)!.map((p, i) => (
                    <>
                      {(i === 0 || blocks.get(bs)![i - 1].year !== p.year) && <span class="q-year">{p.year}</span>}
                      <a
                        href={p.href}
                        class:list={['q-item', { 'q-current': p.key === currentKey }]}
                        aria-current={p.key === currentKey ? 'page' : undefined}
                        title={`${p.label} · ${p.count} post${p.count !== 1 ? 's' : ''}`}
                      >
                        Q{p.quarter}
                      </a>
                    </>
                  ))}
                </div>
              ))}
            </div>
            <button type="button" class="q-arrow q-arrow--next" data-q-next aria-label="Show later quarters">→</button>
          </nav>
        )}

        {/* Empty state if no posts */}
        {posts.length === 0 && (
          <Card class="empty-state">
            <div class="empty-message">
              <Badge>coming soon</Badge>
              <p>No blog posts published yet. Check back soon!</p>
            </div>
          </Card>
        )}
      </div>

      {/* Sidebar — browse the log by document type */}
      <aside class="sidebar">
        <h2 class="sidebar-heading">Browse</h2>
        <nav class="type-nav" aria-label="Browse by type">
          {typeNav.map((t) => (
            <a href={t.href} class:list={['type-card', `type-card--${t.tone}`]}>
              <span class="tc-label">{t.label}</span>
              <span class="tc-count">{t.count}</span>
              <span class="tc-arrow" aria-hidden="true">→</span>
            </a>
          ))}
        </nav>
      </aside>
    </div>
  </main>

  <!-- Image Gallery Lightbox -->
  <ImageGallery />

  <!-- Theme Modal -->
  <ThemeModal />

  <!-- Enhanced UI Interactions -->
  <UIInteractions />

  <!-- Keyboard Shortcuts and Accessibility -->
  <KeyboardShortcuts />

  <!-- Performance Optimization and Monitoring -->
  <PerformanceOptimizer />

  <script>
    // Wire up nature photo grids to the image gallery lightbox
    document.querySelectorAll('.nature-photo-grid').forEach((grid) => {
      const urls = JSON.parse((grid as HTMLElement).dataset.galleryUrls || '[]');
      const images = urls.map((url: string) => ({ src: url, alt: 'iNaturalist observation', caption: '' }));
      grid.querySelectorAll('.nature-photo').forEach((img) => {
        (img as HTMLElement).style.cursor = 'zoom-in';
        img.addEventListener('click', () => {
          const idx = parseInt((img as HTMLElement).dataset.galleryIndex || '0', 10);
          (window as any).openGallery?.(images, idx);
        });
      });
    });

    // Quarter navigator: ←/→ page through 2-year blocks in place (no navigation).
    const qNav = document.querySelector<HTMLElement>('[data-q-nav]');
    if (qNav) {
      const qBlocks = [...qNav.querySelectorAll<HTMLElement>('.q-block')];
      const qPrev = qNav.querySelector<HTMLButtonElement>('[data-q-prev]');
      const qNext = qNav.querySelector<HTMLButtonElement>('[data-q-next]');
      let qIdx = Number(qNav.dataset.blockIndex || '0');
      const showBlock = () => {
        qBlocks.forEach((b, i) => { b.hidden = i !== qIdx; });
        if (qPrev) qPrev.disabled = qIdx <= 0;
        if (qNext) qNext.disabled = qIdx >= qBlocks.length - 1;
      };
      qPrev?.addEventListener('click', () => { if (qIdx > 0) { qIdx--; showBlock(); } });
      qNext?.addEventListener('click', () => { if (qIdx < qBlocks.length - 1) { qIdx++; showBlock(); } });
      showBlock();
    }
  </script>

  <!-- Theme toggle button -->
  <Button
    variant="ghost"
    size="md"
    id="themeControl"
    class="theme-toggle-button"
    onclick="window.openThemeModal && window.openThemeModal()"
    aria-label="Change theme"
    title="Change theme (Ctrl+T)"
  >
    🎨
  </Button>
</BaseLayout>

<style>
  @import '../../styles/tokens.css';
  @import '../../styles/themes.css';
  @import '../../styles/backgrounds.css';

  /* Clean, traditional blog styling */
  .blog-container {
    min-height: 100vh;
    background: var(--bg-primary);
    color: var(--text-primary);
    padding: var(--space-3xl) var(--page-gutter);
    position: relative;
    overflow: hidden; /* Required for animated backgrounds */
  }

  .blog-wrapper {
    max-width: 1400px;
    margin: 0 auto;
    position: relative;
    z-index: 10; /* Above animated backgrounds */
    display: grid;
    grid-template-columns: 1fr 380px;
    gap: var(--space-3xl);
    align-items: start;
  }

  .main-content {
    min-width: 0; /* Prevents grid blowout */
  }

  .sidebar {
    position: sticky;
    top: var(--space-3xl);
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
  }

  .sidebar-heading {
    font-family: var(--font-family);
    font-size: var(--text-lg);
    font-weight: var(--font-bold);
    color: var(--text-primary);
    margin: 0;
    padding-bottom: var(--space-md);
    border-bottom: var(--border-width) solid var(--gradient-primary-subtle);
    letter-spacing: var(--tracking-tight);
  }

  /* Section Styles */
  .blog-header-section {
    position: relative;
    margin: var(--space-2xl) 0;
  }

  .featured-posts-section,
  .archive-posts-section {
    position: relative;
    margin: var(--space-xl) 0;
  }

  .archive-posts-section {
    margin-top: var(--space-3xl);
    padding-top: var(--space-3xl);
    border-top: var(--border-width) solid var(--gradient-primary-subtle);
  }

  .section-heading {
    font-family: var(--font-family);
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    margin: 0 0 var(--space-xl) 0;
  }

  .blog-header {
    text-align: left;
    padding-bottom: var(--space-xl);
    border-bottom: var(--border-width) solid var(--gradient-primary-subtle);
  }

  .blog-header :global(.badge) {
    margin-bottom: var(--space-md);
  }

  /* Tag Cloud Styles */
  .tag-cloud {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-md);
    margin-top: var(--space-lg);
  }

  .tag-cloud-label {
    font-family: var(--font-family);
    font-size: var(--text-lg);
    color: var(--text-secondary);
    font-weight: var(--font-medium);
    margin-right: var(--space-xs);
  }

  .tag-cloud-item {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    background: var(--bg-secondary);
    color: var(--text-primary);
    padding: var(--space-sm) var(--space-md);
    border: var(--border-width) solid var(--accent-primary);
    border-radius: var(--radius-full);
    text-decoration: none;
    font-family: var(--font-family);
    font-size: var(--text-base);
    font-weight: var(--font-medium);
    transition: all var(--duration-base) var(--ease-out);
    box-shadow: var(--shadow-sm) var(--accent-secondary);
  }

  .tag-cloud-item:hover {
    background: var(--accent-primary);
    color: var(--text-light);
    transform: translateY(-2px);
    box-shadow: var(--shadow-md) var(--accent-secondary);
  }

  .tag-count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 24px;
    height: 24px;
    padding: 0 var(--space-xs);
    background: var(--gradient-primary-light);
    color: var(--text-primary);
    border-radius: var(--radius-full);
    font-size: var(--text-xs);
    font-weight: var(--font-bold);
    border: var(--border-width) solid var(--accent-secondary);
  }

  .tag-cloud-item:hover .tag-count {
    background: var(--accent-secondary);
    color: var(--bg-dark);
  }

  /* Browse all links */
  .browse-all-link {
    font-family: var(--font-family);
    font-size: var(--text-sm);
    font-weight: 400;
    color: var(--text-secondary);
    text-decoration: none;
    margin-left: var(--space-sm);
    transition: color 0.2s ease;
  }

  .browse-all-link:hover {
    color: var(--text-primary);
    text-decoration: underline;
  }

  /* Featured Links Section */
  .featured-links-section {
    position: relative;
    margin: var(--space-xl) 0;
  }

  .featured-links-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-lg);
    flex-wrap: wrap;
  }

  .featured-links-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-lg);
  }

  /* Posts Header */
  .posts-header {
    margin-bottom: var(--space-xl);
  }

  /* Featured Posts Styles */
  .featured-posts {
    display: grid;
    gap: var(--space-3xl);
    min-width: 0;
  }

  .featured-post-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    transform: var(--rotation-sm);
    padding: var(--space-2xl);
    min-width: 0;
  }

  .featured-post-card:nth-child(even) {
    transform: var(--rotation-sm);
  }

  /* Archive Posts Styles */
  .archive-posts {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-xl);
  }

  .archive-post-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    transform: var(--rotation-sm);
    transition: all var(--duration-base) var(--ease-out);
  }

  .archive-post-card:nth-child(even) {
    transform: var(--rotation-sm);
  }

  .archive-post-card:hover {
    transform: scale(1.05);
    box-shadow: var(--shadow-xl) var(--accent-secondary);
    z-index: 5;
  }

  .post-title {
    font-family: var(--font-family-system);
    font-size: var(--heading-lg);
    font-weight: var(--font-bold);
    margin: 0 0 var(--space-md) 0;
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
  }

  .post-title-link {
    color: var(--text-primary);
    text-decoration: none;
    transition: color var(--duration-base) var(--ease-out);
  }

  .post-title-link:hover {
    color: var(--accent-primary);
  }

  .post-title-text {
    color: var(--text-primary);
  }

  .collection-badge {
    margin-left: var(--space-sm);
  }

  .post-description {
    color: var(--text-secondary);
    font-family: var(--font-family);
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    margin: 0;
    font-style: italic;
    border-left: 3px solid var(--accent-primary);
    padding-left: var(--space-md);
  }

  /* Hero image styles */
  .post-hero-image {
    margin: var(--space-lg) 0;
    border-radius: var(--border-radius);
    overflow: hidden;
    border: var(--border-width) solid var(--accent-primary);
    box-shadow: var(--shadow-lg) var(--accent-secondary);
  }

  .post-hero-image img,
  .post-hero-image video {
    width: 100%;
    height: auto;
    max-height: 400px;
    object-fit: cover;
    display: block;
    transition: transform var(--duration-base) var(--ease-out);
  }

  .post-hero-link {
    display: block;
    overflow: hidden;
  }

  .post-hero-link:hover img,
  .post-hero-link:hover video {
    transform: scale(1.05);
  }

  .post-excerpt {
    color: var(--text-secondary);
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    margin: 0;
  }

  /* Content Preview Styles */
  .post-content-preview {
    color: var(--text-primary);
    font-family: var(--font-family);
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    margin: var(--space-lg) 0;
  }

  .post-excerpt-preview {
    color: var(--text-primary);
    font-family: var(--font-family);
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    margin: var(--space-lg) 0;
  }

  /* Style markdown content in preview */
  .post-content-preview :global(h1),
  .post-content-preview :global(h2),
  .post-content-preview :global(h3),
  .post-content-preview :global(h4),
  .post-excerpt-preview :global(h1),
  .post-excerpt-preview :global(h2),
  .post-excerpt-preview :global(h3),
  .post-excerpt-preview :global(h4) {
    color: var(--text-primary);
    font-weight: var(--font-bold);
    margin: var(--space-lg) 0 var(--space-sm) 0;
    line-height: var(--leading-tight);
  }

  .post-content-preview :global(h2),
  .post-excerpt-preview :global(h2) {
    font-size: var(--text-xl);
    color: var(--accent-primary);
  }

  .post-content-preview :global(h3),
  .post-excerpt-preview :global(h3) {
    font-size: var(--text-lg);
  }

  .post-content-preview :global(p),
  .post-excerpt-preview :global(p) {
    margin: var(--space-md) 0;
  }

  .post-content-preview :global(a),
  .post-excerpt-preview :global(a) {
    color: var(--accent-primary);
    text-decoration: underline;
    text-decoration-color: var(--accent-secondary);
  }

  .post-content-preview :global(strong),
  .post-excerpt-preview :global(strong) {
    font-weight: var(--font-bold);
    color: var(--text-primary);
  }

  .post-content-preview :global(em),
  .post-excerpt-preview :global(em) {
    font-style: italic;
  }

  .post-content-preview :global(ul),
  .post-content-preview :global(ol),
  .post-excerpt-preview :global(ul),
  .post-excerpt-preview :global(ol) {
    margin: var(--space-md) 0;
    padding-left: var(--space-xl);
  }

  .post-content-preview :global(li),
  .post-excerpt-preview :global(li) {
    margin: var(--space-xs) 0;
  }

  .post-content-preview :global(code),
  .post-excerpt-preview :global(code) {
    background: var(--gradient-secondary-light);
    color: var(--bg-dark);
    padding: var(--space-xs) var(--space-sm);
    border-radius: var(--radius-sm);
    font-size: var(--text-sm);
  }

  .post-content-preview :global(pre),
  .post-excerpt-preview :global(pre) {
    display: none; /* Hide code blocks in preview to keep it clean */
  }

  .post-content-preview :global(img),
  .post-excerpt-preview :global(img) {
    display: none; /* Hide images in preview */
  }

  /* Show all content for full posts */
  .post-content-preview.full-content :global(pre) {
    display: block;
    background: var(--bg-dark);
    color: var(--text-light);
    padding: var(--space-xl);
    margin: var(--space-2xl) 0;
    border: var(--border-width) solid var(--accent-primary);
    border-radius: var(--border-radius);
    box-shadow: var(--shadow-md) var(--accent-secondary);
    overflow-x: auto;
  }

  .post-content-preview.full-content :global(pre code) {
    background: none;
    border: none;
    color: inherit;
    padding: 0;
  }

  .post-content-preview.full-content :global(img) {
    display: block;
    max-width: 100%;
    height: auto;
    margin: var(--space-2xl) auto;
    border: var(--border-width) solid var(--accent-primary);
    border-radius: var(--border-radius);
    box-shadow: var(--shadow-lg) var(--accent-secondary);
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .post-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: var(--space-sm);
    padding-top: var(--space-md);
    border-top: var(--border-width) solid var(--gradient-primary-subtle);
  }

  .post-reading-time {
    font-family: var(--font-family);
    font-size: var(--text-sm);
    color: var(--text-secondary);
  }

  .empty-state {
    text-align: center;
    padding: var(--space-4xl) var(--space-xl);
    margin-top: var(--space-xl);
  }

  .empty-message :global(.badge) {
    margin-bottom: var(--space-md);
  }

  .empty-message p {
    font-family: var(--font-family);
    font-size: var(--text-lg);
    color: var(--text-secondary);
    margin: 0;
  }

  /* Pagination */
  .pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: var(--space-xl);
    margin-top: var(--space-3xl);
    padding-top: var(--space-2xl);
    border-top: var(--border-width) solid var(--gradient-primary-subtle);
  }

  .pagination-link {
    padding: var(--space-md) var(--space-xl);
    background: var(--bg-secondary);
    color: var(--text-primary);
    border: var(--border-width) solid var(--accent-primary);
    border-radius: var(--radius-full);
    text-decoration: none;
    font-family: var(--font-family);
    font-weight: var(--font-medium);
    transition: all var(--duration-base) var(--ease-out);
  }

  .pagination-link:hover:not(.disabled) {
    background: var(--accent-primary);
    color: var(--text-light);
    transform: translateY(-2px);
  }

  .pagination-link.disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  .pagination-info {
    color: var(--text-secondary);
    font-family: var(--font-family);
    font-size: var(--text-sm);
  }

  /* Responsive design */
  @media (max-width: 1024px) {
    .blog-wrapper {
      grid-template-columns: 1fr;
      gap: var(--space-2xl);
    }

    .sidebar {
      position: relative;
      top: 0;
    }

    /* Archive posts still 2 columns on tablet */
    .archive-posts {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-lg);
    }
  }

  @media (max-width: 768px) {
    .blog-container {
      padding: var(--space-xl) var(--page-gutter);
    }

    .blog-header {
      margin-bottom: var(--space-xl);
      padding-bottom: var(--space-lg);
    }

    .tag-cloud {
      gap: var(--space-sm);
    }

    .tag-cloud-item {
      font-size: var(--text-sm);
      padding: var(--space-xs) var(--space-sm);
    }

    .tag-cloud-label {
      font-size: var(--text-base);
    }

    /* Archive posts switch to single column on mobile */
    .archive-posts {
      grid-template-columns: 1fr;
    }

    /* Featured links to single column on mobile */
    .featured-links-grid {
      grid-template-columns: 1fr;
    }

    .featured-links-header {
      flex-direction: column;
      align-items: flex-start;
    }

    .featured-post-card {
      padding: var(--space-lg);
    }

    .post-content-preview {
      font-size: var(--text-sm);
    }

    .post-excerpt-preview {
      font-size: var(--text-sm);
    }

    .post-meta {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-md);
    }
  }

  @media (max-width: 480px) {
    .blog-container {
      padding: var(--space-lg) var(--space-md);
    }

    .featured-post-card {
      padding: var(--space-md);
    }

    .post-title {
      font-size: var(--text-xl);
    }

    .post-description {
      font-size: var(--text-base);
    }

    .post-excerpt {
      font-size: var(--text-sm);
    }

    .pagination {
      flex-direction: column;
      gap: var(--space-md);
    }

    .pagination-link {
      padding: var(--space-sm) var(--space-lg);
      font-size: var(--text-sm);
    }

    .section-heading {
      font-size: var(--heading-md);
    }
  }

    /* Theme toggle button */
    .theme-toggle-button {
      position: fixed;
      bottom: var(--space-xl);
      right: var(--space-xl);
      width: 48px;
      height: 48px;
      border-radius: var(--radius-full);
      z-index: var(--z-sticky);
    }

    @media (max-width: 768px) {
      .theme-toggle-button {
        bottom: var(--space-lg);
        right: var(--space-lg);
        width: 44px;
        height: 44px;
      }
    }

  /* =========================================================
     THE LOG — catalog/field-journal redesign
     Type roles: --font-display (titles), --font-body (reading),
     --font-mono (the call-number rail). Appended last so these
     rules win over the original brutalist card styles above.
     ========================================================= */

  .blog-container {
    font-family: var(--font-body);
    background: none;
  }
  /* One column: about --space-2xl from the wordmark down to the Browse strip,
     the same gap it leaves above its divider */
  @media (max-width: 900px) {
    .blog-container { padding-top: var(--space-lg); }
  }
  @media (max-width: 600px) {
    .blog-container { padding-top: var(--space-xl); }
  }

  /* Two columns on laptop+ : feed (with its internal rail) + index sidebar.
     The main column's children are placed on the wrapper's grid directly, so
     the one-column layout below can reorder them around the sidebar. */
  .blog-wrapper {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 320px;
    grid-template-rows: auto auto 1fr;
    grid-template-areas:
      "feed side"
      "qnav side"
      ". side";
    column-gap: var(--space-2xl);
    row-gap: 0;
    max-width: 1360px;
    align-items: start;
  }
  .main-content { display: contents; }
  .featured-posts-section,
  .blog-wrapper :global(.empty-state),
  .q-nav { min-width: 0; }
  .featured-posts-section,
  .blog-wrapper :global(.empty-state) { grid-area: feed; }
  .q-nav { grid-area: qnav; }
  .sidebar { grid-area: side; }

  /* Tighten the section rhythm around the feed */
  .featured-posts-section,
  .featured-links-section { margin: var(--space-md) 0; }
  /* Grid items don't collapse margins: the gaps around the feed come from its neighbours */
  .featured-posts-section { margin-block: 0; }
  .section-heading {
    font-family: var(--font-mono);
    margin: 0 0 var(--space-sm) 0;
  }

  /* ---- Feed + record grid (the signature) ---- */
  .log-feed { display: block; }

  .log-record {
    padding: var(--space-lg) 0;
    border-top: 1px solid var(--gradient-primary-subtle);
  }
  .log-record:first-child { border-top: none; padding-top: var(--space-sm); }
  /* A picked definition: italic, with a red rule */
  .log-record .post-quote {
    margin: 0 0 var(--space-md) 0;
    padding: 2px 0 2px var(--space-sm);
    border-left: 3px solid var(--accent-primary);
    font-family: var(--font-body);
    font-style: italic;
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    color: var(--text-secondary);
    max-width: 68ch;
  }
  .log-record .post-quote :global(strong) { font-style: normal; color: var(--text-primary); }

  /* Two title sizes. A beat has no date, less space between dividers (16px vs
     a post's 24px), and its title at the size of a subheading inside a post
     (h2, text-xl). */
  .log-record[data-size="beat"] { padding: var(--space-md) 0; }
  .log-record[data-size="beat"] .post-title { font-size: var(--text-xl); margin-bottom: var(--space-sm); }
  .log-record[data-size="beat"] :global(.featured-post-card) { gap: var(--space-sm); }
  .log-record[data-size="beat"] .post-quote,
  .log-record[data-size="beat"] .post-content-preview { margin: 0; }
  .log-record[data-size="beat"] .post-content-preview :global(p) { margin: 0; }

  /* Titles are links, so they look like links */
  .log-record .post-title-link {
    text-decoration: underline;
    text-underline-offset: 0.15em;
    text-decoration-thickness: 2px;
    text-decoration-color: var(--accent-secondary);
  }
  .log-record .post-title-link:hover { color: var(--accent-secondary); }
  /* The term inside a post's definition quote reads as an inline link */
  .log-record .post-quote :global(a) {
    color: var(--accent-primary);
    text-decoration: underline;
    text-decoration-color: var(--accent-secondary);
  }
  .log-record .title-quote { color: var(--accent-primary); }
  .log-record .post-quote :global(.quote-credit) {
    display: block;
    margin-top: var(--space-xs);
    font-style: normal;
    font-size: var(--text-sm);
    color: var(--text-secondary);
  }
  .record-date-link { text-decoration: none; color: inherit; }
  .record-date-link[href]:hover .record-date { color: var(--accent-primary); text-decoration: underline; }
  .post-title-ext { font-family: var(--font-body); font-size: 0.7em; color: var(--text-secondary); }

  /* ---- Record body: neutralize old brutalist card chrome ---- */
  .log-record .featured-post-card {
    padding: 0;
    margin: 0;
    transform: none;
    box-shadow: none;
    border: none;
    background: none;
    gap: var(--space-sm);
  }

  /* Date eyebrow above each post title */
  .log-record .record-date {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-secondary);
    letter-spacing: var(--tracking-wide);
    margin-bottom: var(--space-xs);
  }

  /* Titles in the display face */
  .log-record .post-title {
    font-family: var(--font-display);
    font-optical-sizing: auto;
    font-weight: var(--font-semibold);
    font-size: var(--heading-md);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    margin: 0 0 var(--space-sm) 0;
  }
  .log-record .post-title-link { color: var(--text-primary); }
  .log-record .post-title-link:hover { color: var(--accent-primary); }

  /* Reading text in the body face */
  .log-record .post-description,
  .log-record .post-excerpt-preview,
  .log-record .post-content-preview {
    font-family: var(--font-body);
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    color: var(--text-secondary);
    max-width: 68ch;
  }

  /* ---- Neutralize component chrome inside records (Card/Badge/Button
     are scoped to their own components, so reach them with :global) ---- */
  .record-body :global(.card) {
    padding: 0;
    background: none;
    border: none;
    box-shadow: none;
    border-radius: 0;
  }

  /* Tags → quiet mono outline chips, matching the tag index */
  .record-body :global(.badge) {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: var(--font-normal);
    text-transform: none;
    letter-spacing: 0;
    color: var(--text-secondary);
    background: none;
    border: 1px solid var(--gradient-primary-subtle);
    border-radius: var(--radius-sm);
    box-shadow: none;
    padding: 1px var(--space-sm);
  }
  .record-body :global(.badge:hover) {
    color: var(--text-primary);
    border-color: var(--accent-primary);
    background: none;
  }

  /* Primary buttons → understated mono text links */
  .record-body :global(.btn--primary) {
    padding: 0;
    background: none;
    border: none;
    box-shadow: none;
    color: var(--accent-primary);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    text-transform: none;
    transform: none;
  }
  .record-body :global(.btn--primary):hover {
    background: none;
    color: var(--accent-primary);
    text-decoration: underline;
    transform: none;
  }

  .log-record .post-description {
    background: none;
    border: none;
    padding: 0;
    margin: 0;
  }

  .log-record .species-chip {
    border-color: var(--gradient-primary-subtle);
  }

  /* ---- Index sidebar (right column) — quiet, flat, to match the feed ---- */
  .sidebar {
    position: sticky;
    top: var(--space-xl);
    align-self: start;
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }
  .sidebar-heading {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: var(--font-bold);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    padding-bottom: var(--space-sm);
    border-bottom: 2px solid var(--text-primary);
  }
  /* Browse-by-type cards — brutalist energy against the calm feed */
  .type-nav {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }
  .type-card {
    display: flex;
    align-items: baseline;
    gap: var(--space-sm);
    padding: var(--space-md) var(--space-lg);
    font-family: var(--font-mono);
    text-decoration: none;
    border: var(--border-width) solid var(--bg-dark);
    box-shadow: var(--shadow-md) var(--bg-dark);
    transition: transform var(--duration-base) var(--ease-out),
                box-shadow var(--duration-base) var(--ease-out);
  }
  .type-card:hover {
    transform: translate(-3px, -3px);
    box-shadow: var(--shadow-lg) var(--bg-dark);
  }
  .type-card:focus-visible {
    outline: var(--border-width) solid var(--bg-dark);
    outline-offset: 3px;
  }
  .tc-label {
    font-size: var(--text-lg);
    font-weight: var(--font-bold);
    letter-spacing: var(--tracking-tight);
  }
  .tc-count {
    font-size: var(--text-sm);
    opacity: 0.75;
  }
  .tc-arrow {
    margin-left: auto;
    font-size: var(--text-lg);
    font-weight: var(--font-bold);
    transition: transform var(--duration-base) var(--ease-out);
  }
  .type-card:hover .tc-arrow { transform: translateX(4px); }

  /* Tones cycle the brand accents, like the homepage cards */
