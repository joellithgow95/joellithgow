---
import { marked } from 'marked';
import { fetchBlogPosts } from '@lib/astraeus';
import type { AstraeusDocument, BlogPost, SpotifyDump, NatureOuting } from '@lib/astraeus-types';
import type { AnyBlogPost } from '@lib/astraeus';
import BaseLayout from '@components/common/BaseLayout.astro';
import ThemeModal from '@components/modals/ThemeModal.astro';
import UIInteractions from '@components/interactive/UIInteractions.astro';
import KeyboardShortcuts from '@components/interactive/KeyboardShortcuts.astro';
import PerformanceOptimizer from '@components/ui/PerformanceOptimizer.astro';
import Card from '@components/primitives/Card.astro';
import Badge from '@components/primitives/Badge.astro';
import Button from '@components/primitives/Button.astro';
import LinksAccordion from '@components/blog/LinksAccordion.astro';
import PostSlices from '@components/blog/slices/PostSlices.astro';
import { resolveSlices } from '@lib/slices';
import '../../styles/log.css';

export async function getStaticPaths() {
  const allPosts = await fetchBlogPosts();
  // Every post gets a detail page
  return allPosts.map(post => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: AnyBlogPost;
}

const { post } = Astro.props;
const kind = post.kind;
const { title, publish_date } = post;
const description = ('description' in post && (post as any).description) || '';
const tags = post.tags || [];
// Fields only on BlogPost
const author = ('author' in post && (post as any).author) as string | undefined;
const reading_time = ('reading_time' in post && (post as any).reading_time) as number | undefined;
const image = ('image' in post && (post as any).image) as AstraeusDocument<BlogPost>['image'] | undefined;
const links = ('links' in post && (post as any).links) as AstraeusDocument<BlogPost>['links'] | undefined;
const publishDate = new Date(publish_date);
// The data this post shows (ADR 026 slices), resolved at build time
const slices = kind === 'post' ? await resolveSlices((post as any).data) : [];

// Typed views for new post types (cast once in frontmatter, not in template)
const spotifyDump = kind === 'spotify_dump' ? (post as AstraeusDocument<SpotifyDump> & { kind: 'spotify_dump' }) : null;
const natureOuting = kind === 'nature_outing' ? (post as AstraeusDocument<NatureOuting> & { kind: 'nature_outing' }) : null;

// JSON-LD structured data for BlogPosting
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description: description,
  author: {
    '@type': 'Person',
    name: author,
    url: 'https://joellithgow.com',
  },
  datePublished: publishDate.toISOString(),
  dateModified: publishDate.toISOString(),
  keywords: tags?.join(', '),
  url: `https://joellithgow.com/blog/${post.slug}`,
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': `https://joellithgow.com/blog/${post.slug}`,
  },
  publisher: {
    '@type': 'Person',
    name: 'Joel Lithgow',
    url: 'https://joellithgow.com',
  },
};

if (image) {
  (jsonLd as Record<string, unknown>)['image'] = {
    '@type': 'ImageObject',
    url: new URL(image.src, Astro.url).href,
    description: image.alt || title,
  };
}

// Breadcrumb structured data for search results
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: 'https://joellithgow.com',
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Blog',
      item: 'https://joellithgow.com/blog',
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: title,
    },
  ],
};
---

<BaseLayout
  title={title}
  description={description}
  ogType="article"
  articlePublishedTime={publishDate.toISOString()}
  articleAuthor={author}
  articleTags={tags}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <main
    class="article-container"
    data-cms-id={post._id}
    data-cms-type="blog_post"
  >
    <div class="article-wrapper">
      <div>
        <nav class="article-nav">
          <Button href="/blog" variant="secondary" size="md" class="nav-back-btn">← Back to blog</Button>
        </nav>

        {/* SPOTIFY DUMP LAYOUT — inside the same .blog-article card as regular posts */}
        {spotifyDump && (
          <article class="blog-article">
            <header class="article-header">
              <div class="article-meta-top">
                <time datetime={new Date(spotifyDump.publish_date).toISOString()} class="article-date">
                  {new Date(spotifyDump.publish_date).toLocaleDateString('en-US', { year: 'numeric', month: 'long' })}
                </time>
              </div>
              <h1 class="article-title" data-cms-field="title">🎵 {spotifyDump.title}</h1>
              {spotifyDump.description && <p class="article-description" data-cms-field="description">{spotifyDump.description}</p>}
              <div class="article-meta">
                <div class="author-info">
                  <span>{spotifyDump.song_count ?? spotifyDump.songs?.length ?? 0} tracks</span>
                </div>
                {tags && tags.length > 0 && (
                  <div class="article-tags" data-cms-field="tags">
                    {tags.map((tag) => (
                      <Badge href={`/blog/tags/${tag}`} size="sm">#{tag}</Badge>
                    ))}
                  </div>
                )}
              </div>
            </header>

            {spotifyDump.songs && spotifyDump.songs.length > 0 && (
              <div class="article-content">
                <div class="spotify-song-list">
                  {spotifyDump.songs.map((song) => (
                    <div class="spotify-song-item">
                      <div class="song-info">
                        <a href={song.spotify_url} class="song-title" target="_blank" rel="noopener noreferrer">
                          {song.track_name}
                        </a>
                        <span class="song-artist">{song.artist_name}</span>
                        {song.album_name && <span class="song-album">{song.album_name}</span>}
                      </div>
                      <time class="song-liked-at" datetime={song.liked_at}>
                        {new Date(song.liked_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric' })}
                      </time>
                    </div>
                  ))}
                </div>
              </div>
            )}
          </article>
        )}

        {/* INATURALIST OUTING LAYOUT — inside the same .blog-article card as regular posts */}
        {natureOuting && (
          <article class="blog-article">
            <header class="article-header">
              <div class="article-meta-top">
                <time datetime={new Date(natureOuting.publish_date).toISOString()} class="article-date">
                  {new Date(natureOuting.publish_date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
                </time>
              </div>
              <h1 class="article-title" data-cms-field="title">🌿 {natureOuting.title}</h1>
              {natureOuting.description && <p class="article-description" data-cms-field="description">{natureOuting.description}</p>}
              <div class="article-meta">
                <div class="author-info">
                  <span>{natureOuting.observation_count ?? natureOuting.observations?.length ?? 0} observations</span>
                  {natureOuting.species_list && <span> · {natureOuting.species_list.length} species</span>}
                  {natureOuting.place_guess && <span> · 📍 {natureOuting.place_guess}</span>}
                </div>
                {tags && tags.length > 0 && (
                  <div class="article-tags" data-cms-field="tags">
                    {tags.map((tag) => (
                      <Badge href={`/blog/tags/${tag}`} size="sm">#{tag}</Badge>
                    ))}
                  </div>
                )}
              </div>
            </header>

            <div class="article-content">
              {natureOuting.photo_urls && natureOuting.photo_urls.length > 0 && (
                <section class="nature-photos-section">
                  <h2>Photos</h2>
                  <div class="nature-photo-grid">
                    {natureOuting.photo_urls.slice(0, 12).map((url) => (
                      <a href={url} target="_blank" rel="noopener noreferrer" class="nature-photo-link">
                        <img src={url.replace('original', 'medium')} alt="Observation photo" loading="lazy" class="nature-photo" />
                      </a>
                    ))}
                  </div>
                </section>
              )}

              {natureOuting.species_list && natureOuting.species_list.length > 0 && (
                <section>
                  <h2>Species ({natureOuting.species_list.length})</h2>
                  <ul class="species-list">
                    {natureOuting.species_list.map((name) => (
                      <li class="species-item">{name}</li>
                    ))}
                  </ul>
                </section>
              )}

              {natureOuting.bounding_box && (
                <section>
                  <h2>Location</h2>
                  <p class="bounding-box-info">
                    Lat {natureOuting.bounding_box.lat_min.toFixed(4)}–{natureOuting.bounding_box.lat_max.toFixed(4)},
                    Lon {natureOuting.bounding_box.lon_min.toFixed(4)}–{natureOuting.bounding_box.lon_max.toFixed(4)}
                  </p>
                </section>
              )}
            </div>
          </article>
        )}

        {/* REGULAR ARTICLE LAYOUT */}
        {/* spotifyDump and natureOuting render their own layouts above — skip entirely for those */}
        {!spotifyDump && !natureOuting && (
          <article class="blog-article">
            {/* Hero-style header with featured image/video */}
            {image && (
              <div class="article-hero" data-cms-field="image">
                {image.type === 'video' ? (
                  <video autoplay loop muted playsinline class="hero-image">
                    <source src={image.src} type="video/webm" />
                  </video>
                ) : (
                  <img
                    src={image.src}
                    alt={image.alt}
                    class="hero-image"
                  />
                )}
              </div>
            )}

            {/* Article header */}
            <header class="article-header">
              <div class="article-meta-top">
                <time
                  datetime={publishDate.toISOString()}
                  class="article-date"
                >
                  {publishDate.toLocaleDateString('en-US', {
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric'
                  })}
                </time>
              </div>

              <h1 class="article-title" data-cms-field="title">{title}</h1>

              <p class="article-description" data-cms-field="description">
                {description}
              </p>

              <div class="article-meta">
                <div class="author-info">
                  <span>By {author}</span>
                  {reading_time && (
                    <span> • {reading_time} min read</span>
                  )}
                </div>

                {tags && tags.length > 0 && (
                  <div class="article-tags" data-cms-field="tags">
                    {tags.map((tag) => (
                      <Badge href={`/blog/tags/${tag}`} size="sm">#{tag}</Badge>
                    ))}
                  </div>
                )}
              </div>
            </header>

            {/* Article content */}
            <div class="article-content" data-cms-field="body_markdown" data-cms-field-type="markdown" set:html={marked.parse(('body_markdown' in post ? (post as any).body_markdown : null) ?? '')}></div>

            {slices.length > 0 && (
              <div class="article-slices">
                <PostSlices slices={slices} />
              </div>
            )}

            {/* The post's links, same accordion as the links page */}
            {links && links.length > 0 && (
              <section class="links-section">
                <div class="links-header">
                  <h2 class="links-title">Links</h2>
                  <div class="links-meta">
                    <span class="links-count">{links.length} link{links.length !== 1 ? 's' : ''}</span>
                  </div>
                </div>

                <LinksAccordion links={links.map((l) => ({ url: l.url, title: l.title, description: l.description }))} />
              </section>
            )}
          </article>
        )}
      </div>

        <footer class="article-footer">
          <nav class="footer-nav">
            <Button href="/blog" variant="tertiary" size="md" class="footer-nav-btn footer-nav-back">
              ← Back to all posts
            </Button>

            <Button href="/" variant="tertiary" size="md" class="footer-nav-btn footer-nav-home">
              Home →
            </Button>
          </nav>
        </footer>
      </div>
    </div>
  </main>

  <!-- Theme Modal -->
  <ThemeModal />

  <!-- Enhanced UI Interactions -->
  <UIInteractions />

  <!-- Keyboard Shortcuts and Accessibility -->
  <KeyboardShortcuts />

  <!-- Performance Optimization and Monitoring -->
  <PerformanceOptimizer />

  <!-- Theme toggle button -->
  <Button
    variant="ghost"
    size="md"
    id="themeControl"
    class="theme-toggle-button"
    onclick="window.openThemeModal && window.openThemeModal()"
    aria-label="Change theme"
    title="Change theme (Ctrl+T)"
  >
    🎨
  </Button>
</BaseLayout>

<style>
  @import '../../styles/tokens.css';
  @import '../../styles/themes.css';
  @import '../../styles/backgrounds.css';

  /* Blog post styling aligned with design system */
  /* Transparent so the site-wide grid shows through; the article itself sits
     in a solid .blog-article card, matching the collection layout. */
  .article-container {
    min-height: 100vh;
    color: var(--text-primary);
    padding: var(--space-2xl) var(--space-lg);
    position: relative;
    overflow: hidden;
  }

  /* Collection page chrome (.blog-container/.blog-wrapper/.main-content/.sidebar/.section-head) comes from log.css */

  .article-wrapper {
    max-width: var(--content-normal);
    margin: 0 auto;
    position: relative;
  }

  .article-nav {
    margin-bottom: var(--space-2xl);
  }

  /* Breadcrumb nav for collections */
  .breadcrumb-nav {
    margin-bottom: var(--space-xl);
  }

  /* Collection header - matches tag/links pages */
  .collection-header {
    text-align: left;
    padding-bottom: var(--space-xl);
    border-bottom: 1px solid var(--gradient-primary-subtle);
    margin-bottom: var(--space-3xl);
  }

  .collection-title {
    font-size: var(--heading-xl);
    font-weight: var(--font-bold);
    color: var(--accent-primary);
    letter-spacing: var(--tracking-tight);
    margin: 0 0 var(--space-md) 0;
    line-height: var(--leading-tight);
  }

  .collection-description {
    font-size: var(--text-lg);
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
    margin: 0 0 var(--space-lg) 0;
  }

  .collection-stats {
    display: flex;
    gap: var(--space-xl);
    flex-wrap: wrap;
    align-items: center;
  }

  .stat-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
  }

  .stat-number {
    font-size: var(--text-2xl);
    font-weight: var(--font-bold);
    color: var(--accent-primary);
    line-height: 1;
  }

  .stat-label {
    font-size: var(--text-xs);
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
  }

  .stat-date {
    font-size: var(--text-sm);
    color: var(--text-secondary);
  }

  .blog-article {
    background: var(--bg-secondary);
    border: var(--border-width) solid var(--accent-primary);
    border-radius: var(--border-radius);
    box-shadow: var(--shadow-xl) var(--accent-secondary);
    position: relative;
    z-index: 10;
    margin-bottom: var(--space-3xl);
  }

  /* Hero-style header */
  .article-hero {
    position: relative;
    width: 100%;
    overflow: hidden;
    border-bottom: var(--border-width) solid var(--accent-primary);
  }

  .hero-image {
    width: 100%;
    height: auto;
    object-fit: contain;
    display: block;
    transition: transform var(--duration-slow) var(--ease-out);
  }

  .blog-article:hover .hero-image {
    transform: scale(1.05);
  }

  .article-header {
    text-align: center;
    margin-bottom: var(--space-3xl);
    padding: 0 var(--space-3xl) var(--space-2xl);
    border-bottom: var(--border-width) solid var(--gradient-primary-subtle);
  }

  .article-meta-top {
    position: relative;
    margin-top: calc(var(--space-md) * -1);
    margin-bottom: var(--space-lg);
  }

  .article-date {
    display: inline-block;
    background: var(--accent-tertiary);
    color: var(--bg-dark);
    padding: var(--space-xs) var(--space-md);
    font-size: var(--text-xs);
    font-weight: var(--font-bold);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    border: var(--border-width) solid var(--bg-dark);
    border-radius: var(--border-radius);
    box-shadow: var(--shadow-sm) var(--accent-primary);
  }

  .article-title {
    font-size: var(--heading-2xl);
    font-weight: var(--font-bold);
    margin: var(--space-lg) 0;
    color: var(--text-primary);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
  }

  .article-description {
    font-size: var(--text-xl);
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-2xl);
    font-style: italic;
  }

  .article-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-md);
  }

  .author-info {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    font-weight: var(--font-medium);
  }

  .article-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  /* Article content styling */
  .article-content {
    position: relative;
    z-index: 2;
    line-height: var(--leading-relaxed);
    font-size: var(--text-lg);
    padding: 0 var(--space-3xl) var(--space-2xl);
  }

  /* Slices sit under the body, at the body's width */
  .article-slices {
    position: relative;
    z-index: 2;
    padding: 0 var(--space-3xl) var(--space-2xl);
  }

  .article-content :global(h1),
  .article-content :global(h2),
  .article-content :global(h3),
  .article-content :global(h4),
  .article-content :global(h5),
  .article-content :global(h6) {
    color: var(--text-primary);
    font-weight: var(--font-bold);
    margin: var(--space-2xl) 0 var(--space-md) 0;
    position: relative;
    letter-spacing: var(--tracking-tight);
  }

  .article-content :global(h1) {
    font-size: var(--heading-xl);
    color: var(--accent-primary);
  }

  .article-content :global(h2) {
    font-size: var(--heading-lg);
    color: var(--accent-primary);
    padding-bottom: var(--space-sm);
    border-bottom: var(--border-width) solid var(--gradient-primary-subtle);
  }

  .article-content :global(h3) {
    font-size: var(--heading-md);
    color: var(--text-primary);
  }

  .article-content :global(h4),
  .article-content :global(h5),
  .article-content :global(h6) {
    font-size: var(--heading-sm);
    color: var(--text-primary);
  }

  .article-content :global(p) {
    margin: var(--space-lg) 0;
    color: var(--text-primary);
  }

  .article-content :global(a) {
    color: var(--accent-primary);
    text-decoration: underline;
    text-decoration-color: var(--accent-secondary);
    text-underline-offset: 3px;
    transition: all var(--duration-base) var(--ease-out);
  }

  .article-content :global(a:hover) {
    color: var(--accent-secondary);
    text-decoration-color: var(--accent-primary);
  }

  .article-content :global(strong) {
    color: var(--text-primary);
    font-weight: var(--font-bold);
  }

  .article-content :global(em) {
    color: var(--text-secondary);
    font-style: italic;
  }

  .article-content :global(ul),
  .article-content :global(ol) {
    margin: var(--space-lg) 0;
    padding-left: var(--space-2xl);
  }

  .article-content :global(li) {
    margin: var(--space-sm) 0;
    color: var(--text-primary);
    line-height: var(--leading-relaxed);
  }

  .article-content :global(ul li::marker) {
    color: var(--accent-primary);
  }

  .article-content :global(ol li::marker) {
    color: var(--accent-secondary);
    font-weight: var(--font-bold);
  }

  .article-content :global(blockquote) {
    background: var(--gradient-primary-light);
    border-left: 4px solid var(--accent-primary);
    padding: var(--space-lg);
    margin: var(--space-2xl) 0;
    border-radius: var(--border-radius);
    font-style: italic;
    color: var(--text-primary);
  }

  .article-content :global(code) {
    background: var(--gradient-secondary-light);
    color: var(--bg-dark);
    padding: var(--space-xs) var(--space-sm);
    border: var(--border-width) solid var(--accent-secondary);
    border-radius: var(--radius-sm);
    font-family: var(--font-family);
    font-weight: var(--font-medium);
    font-size: var(--text-sm);
  }

  .article-content :global(pre) {
    background: var(--bg-dark);
    color: var(--text-light);
    padding: var(--space-xl);
    margin: var(--space-2xl) 0;
    border: var(--border-width) solid var(--accent-primary);
    border-radius: var(--border-radius);
    box-shadow: var(--shadow-md) var(--accent-secondary);
    overflow-x: auto;
  }

  .article-content :global(pre code) {
    background: none;
    border: none;
    color: inherit;
    padding: 0;
  }

  .article-content :global(img) {
    max-width: 100%;
    height: auto;
    display: block;
    margin: var(--space-2xl) auto;
    border: var(--border-width) solid var(--accent-primary);
    border-radius: var(--border-radius);
    box-shadow: var(--shadow-lg) var(--accent-secondary);
    transition: all var(--duration-base) var(--ease-out);
  }

  .article-content :global(img:hover) {
    transform: scale(1.02);
    box-shadow: var(--shadow-xl) var(--accent-secondary);
  }

  .article-content :global(.image-grid) {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-lg);
    margin: var(--space-2xl) 0;
  }

  .article-content :global(.image-grid img) {
    margin: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .article-content :global(.image-row) {
    display: flex;
    gap: var(--space-lg);
    margin: var(--space-2xl) 0;
    flex-wrap: wrap;
  }

  .article-content :global(.image-row img) {
    margin: 0;
    flex: 1;
    min-width: 250px;
  }

  .article-content :global(hr) {
    border: none;
    height: var(--border-width);
    background: var(--gradient-primary-subtle);
    margin: var(--space-3xl) 0;
  }

  .article-content :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: var(--space-2xl) 0;
    background: var(--bg-secondary);
    border: var(--border-width) solid var(--accent-primary);
    border-radius: var(--border-radius);
    box-shadow: var(--shadow-md) var(--accent-secondary);
    overflow: hidden;
  }

  .article-content :global(th),
  .article-content :global(td) {
    padding: var(--space-md);
    text-align: left;
    border: var(--border-width) solid var(--gradient-primary-subtle);
  }

  .article-content :global(th) {
    background: var(--accent-primary);
