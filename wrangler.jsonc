// joellithgow.com on Cloudflare Workers static assets: no Worker script, just the
// Astro build in dist/. Deployed by .github/workflows/deploy-site.yml.
//
// Custom domains are attached at DNS cutover (see the Leave GoDaddy plan in
// jlithgow-ops): until then the Worker is only on workers.dev and Netlify serves
// joellithgow.com. Cutover adds:
//   "routes": [
//     { "pattern": "joellithgow.com", "custom_domain": true },
//     { "pattern": "www.joellithgow.com", "custom_domain": true }
//   ]
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "joellithgow",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    // Astro builds /about/ as about/index.html; serve /about and /about/ alike.
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "workers_dev": true,
  // No branch previews: only main deploys.
  "preview_urls": false
}
