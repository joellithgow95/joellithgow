// joellithgow.com on Cloudflare Workers static assets: no Worker script, just the
// Astro build in dist/. Deployed by .github/workflows/deploy-site.yml.
//
// No `routes` here on purpose: joellithgow.com and www are custom domains owned by
// jlithgow-ops (terraform/workers.tf), so wrangler only uploads code and never touches
// the hostnames. Don't add routes back.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "joellithgow",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    // Astro builds /about/ as about/index.html; serve /about and /about/ alike.
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "workers_dev": true,
  // No branch previews: only main deploys.
  "preview_urls": false
}
