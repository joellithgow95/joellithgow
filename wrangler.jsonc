// joellithgow.com on Cloudflare Workers static assets: no Worker script, just the
// Astro build in dist/. Deployed by .github/workflows/deploy-site.yml.
//
// Custom domains (see the Leave GoDaddy plan in jlithgow-ops): Cloudflare creates the
// proxied DNS records itself, and refuses while an `@` or `www` record already exists,
// so delete those first.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "joellithgow",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    // Astro builds /about/ as about/index.html; serve /about and /about/ alike.
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "joellithgow.com", "custom_domain": true },
    { "pattern": "www.joellithgow.com", "custom_domain": true }
  ],
  "workers_dev": true,
  // No branch previews: only main deploys.
  "preview_urls": false
}
